rules_version = '2';

// ── Firebase Storage 규칙 ────────────────────────────────────────────────────
//
// 지금 이 파일이 지키는 것은 **승인제 파티의 신청자 제출 사진 하나뿐**이다.
// 파티/플레이스의 일반 이미지는 예전 그대로 Cloudflare R2에 올라간다 — 그쪽은
// 공개 URL이라 누구나 열 수 있고, 그래도 되는 사진들이다.
//
// 신청 사진만 여기로 온 이유: "호스트와 관리자만 볼 수 있어야 한다"는 요구를
// 공개 R2로는 만족시킬 수 없기 때문이다(URL을 아는 사람은 누구나 열 수 있다).
//
// ⚠️ Storage 규칙은 **Firestore를 조회할 수 없다.** firestore.rules의
// isAdmin()(users/{uid}.role == 'admin')이나 파티 문서의 hostId를 여기서
// 확인할 방법이 없다. 그래서 두 가지로 나눈다.
//
//   · 호스트  — 업로드 시 파일 메타데이터에 박아 둔 hostId로 판정한다.
//   · 관리자  — 규칙으로 표현할 수 없다. 관리자 경로는 Admin SDK(Functions)를
//               쓰며, Admin SDK는 규칙을 통과하지 않으므로 그쪽으로 처리한다.
//
// 메타데이터를 신청자가 직접 넣는데 위조 위험은 없는가?
//   신청자는 **자기 폴더에만** 쓸 수 있다(아래 isOwnApplication). 남의 사진에
//   메타데이터를 붙일 수 없으므로, 위조해봐야 자기 사진을 자기가 고른 사람에게
//   열어주는 것뿐이다 — 다른 신청자의 사진은 어떤 조합으로도 읽히지 않는다.

service firebase.storage {
  match /b/{bucket}/o {

    // ── 승인제 파티 신청 사진 ────────────────────────────────────────────
    // 경로: partyApplications/{partyId}/{applicationId}/{photoId}
    //
    // applicationId는 신청 문서 ID와 같다 — 일회성 파티는 `{uid}`,
    // 정기 파티는 `{uid}_{occurrenceId}`다(functions/partyCapacity.js의
    // applicationDocId). 그래서 맨 앞 조각이 곧 소유자 uid다.
    match /partyApplications/{partyId}/{applicationId}/{photoId} {

      // 이 신청이 내 것인가 — `{uid}` 또는 `{uid}_...` 둘 다 받는다.
      function isOwnApplication() {
        return request.auth != null &&
               (applicationId == request.auth.uid ||
                applicationId.matches('^' + request.auth.uid + '_.*'));
      }

      // 이 파일을 올린 사람이 지목한 호스트가 나인가.
      function isHostOfFile() {
        return request.auth != null &&
               resource != null &&
               resource.metadata != null &&
               resource.metadata.keys().hasAll(['hostId']) &&
               resource.metadata.hostId == request.auth.uid;
      }

      // [읽기] 신청자 본인 + 해당 파티 호스트.
      // 다른 참가자는 어느 쪽도 만족하지 못한다 — 경로를 알아내도 열리지 않는다.
      allow read: if isOwnApplication() || isHostOfFile();

      // [쓰기] 신청자 본인만, 자기 폴더에만.
      //
      // 5장 제한은 여기서 셀 수 없다(규칙은 다른 파일을 못 본다) — 신청 문서에
      // 남는 참조를 applyToParty가 검증하므로, 6장을 올려도 6번째는 어떤
      // 화면에도 뜨지 않는다. 여기서 막는 것은 용량·형식·소유자다.
      //
      // hostId는 **있는지 먼저 확인한 뒤** 타입을 본다. 없는 속성을 바로
      // 참조하면 규칙이 평가 예외로 죽는데, 그래도 결과는 거부라 통과되는
      // 일은 없지만 예외에 기대는 규칙은 나중에 조건을 하나 덧붙이는 순간
      // 엉뚱하게 무너진다.
      allow write: if isOwnApplication() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.metadata != null &&
        request.resource.metadata.keys().hasAll(['hostId']) &&
        request.resource.metadata.hostId is string;

      // [삭제] 본인만. 탈퇴 시 일괄 삭제는 Admin SDK가 한다
      //        (functions/accountWithdrawal.js의 applicationAnswers 단계).
      allow delete: if isOwnApplication();
    }

    // 그 밖의 모든 경로는 닫는다 — 이 프로젝트가 Storage를 쓰는 곳은
    // 위 한 군데뿐이고, 새 용도가 생기면 여기 명시적으로 추가한다.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
