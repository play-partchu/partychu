rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 함수 ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isVerified() {
      return isSignedIn() && (
        userDoc(uid()).data.identityVerified == true ||
        userDoc(uid()).data.isVerified == true   // 하위 호환
      );
    }

    function isAdmin() {
      return isSignedIn() && userDoc(uid()).data.role == 'admin';
    }

    function passesAgeRestriction(partyData) {
      let restricted = partyData.get('ageRestrictionEnabled', false);
      let userBirth = userDoc(uid()).data.get('birthYear', null);
      return !restricted ||
             (userBirth != null &&
              userBirth >= partyData.get('minBirthYear', 0) &&
              userBirth <= partyData.get('maxBirthYear', 9999));
    }

    // (신청자 직접 쓰기 경로가 제거되면서 isApplicantUpdateOnly /
    //  onlyAddsSelfToApplicants 헬퍼도 함께 삭제됐다 — parties 규칙 주석 참고.)

    // ── users 컬렉션 ───────────────────────────────────────────────────
    // 정책:
    //   - 본인 또는 관리자만 전체 조회 가능
    //   - 본인확인 완료 후 인증 잠금 필드(gender, birthYear 등) 수정 불가
    //
    // TODO: party_applicants_screen.dart가 파티장 자격으로 신청자 name/gender를
    //       읽어야 하므로 Firebase Functions getApplicants(partyId) 엔드포인트 구현 후
    //       해당 화면을 Function 호출로 전환하면 이 규칙은 그대로 유지 가능.
    match /users/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isAdmin());

      // 관리자 웹 검색/정렬·통계 전용 파생 필드 — Functions(onUserCreated,
      // onUserFieldsWrite, onApplicationStatusWrite, onPartyCreated,
      // onPlaceCreated, memberManagement.js의 각종 트리거/adminUpdateMember)만
      // 기록한다. 클라이언트가 직접 쓸 수 있게 두면 검색 결과를 스스로
      // 조작하거나 이용 통계·호스트 여부·계정 상태·활동 배지를 위조할 수
      // 있어 본인확인 여부와 무관하게 항상 막는다.
      function isDerivedFieldOnlyChange() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'nicknameLower', 'nameLower', 'emailLower', 'stats',
          'isHost', 'hostSince',
          'activityRoles',
          'accountStatus', 'accountStatusUpdatedAt', 'accountStatusUpdatedBy', 'accountStatusReason',
          'adminMemo', 'adminMemoUpdatedAt', 'adminMemoUpdatedBy',
          'isTestAccount', 'lastLoginAt'
        ]);
      }

      // 관리자 웹 "가입 경로" 통계용 — 최초 로그인 시 클라이언트가 한 번만
      // 쓸 수 있다(값이 아직 없고, 정해진 3개 값 중 하나이며, 이 필드
      // 하나만 바뀌는 요청일 때만). 이미 값이 있으면 이후 어떤 로그인
      // 시도로도 덮어쓸 수 없다 — 최초 가입 경로를 그대로 보존한다.
      function isSignupProviderFirstWrite() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signupProvider']) &&
          !('signupProvider' in resource.data) &&
          request.resource.data.signupProvider in ['google', 'kakao', 'naver'];
      }

      // 인증 잠금 필드는 클라이언트가 최초 생성 시에도 쓸 수 없음
      // → Firebase Functions Admin SDK (niceIntcResult)에서만 저장 가능
      allow create: if isSignedIn() && uid() == userId &&
        !request.resource.data.keys().hasAny([
          'isVerified', 'identityVerified', 'identityVerifiedAt',
          'gender', 'birthYear', 'birthMonth', 'birthDay',
          'name', 'di', 'ci', 'identityCiHash',
          'verifiedAt', 'verificationProvider', 'phoneNumber',
          'profileCompleted',
          'role',
          'nicknameLower', 'nameLower', 'emailLower', 'stats',
          'isHost', 'hostSince',
          'activityRoles',
          'accountStatus', 'accountStatusUpdatedAt', 'accountStatusUpdatedBy', 'accountStatusReason',
          'adminMemo', 'adminMemoUpdatedAt', 'adminMemoUpdatedBy',
          'isTestAccount', 'lastLoginAt'
        ]);

      // 인증 잠금 필드 — 본인확인 전후를 가리지 않고 클라이언트가 절대 쓸 수
      // 없다. Admin SDK(niceAuthResult / niceIntcResult)만 기록한다.
      //
      // 예전에는 "아직 미인증이면 잠금 필드도 쓸 수 있다"는 예외가 있었는데,
      // 그러면 클라이언트가 스스로 identityVerified: true와 ci를 써넣어 NICE
      // 인증을 통째로 건너뛸 수 있었다 — "1명의 실사용자 = 계정 1개" 정책은
      // CI가 서버에서만 기록될 때만 성립하므로 이 예외를 제거했다.
      // (앱은 nickname/profileImageUrl/settlementInfo/signupProvider/
      //  lastActiveAt만 쓰므로 이 강화로 깨지는 화면은 없다.)
      function isVerificationFieldChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isVerified', 'identityVerified', 'identityVerifiedAt',
          'gender', 'birthYear', 'birthMonth', 'birthDay',
          'name', 'di', 'ci', 'identityCiHash',
          'verifiedAt', 'verificationProvider', 'phoneNumber',
          'profileCompleted'
        ]);
      }

      // 권한 필드 — 클라이언트가 절대 쓸 수 없다.
      //
      // isAdmin()도, 서버의 adminUpdateMember / backfillIdentityLinks /
      // adminUpdate* 계열 Function도 전부 users/{uid}.role 하나만 보고 관리자를
      // 판정한다. 이 필드를 본인 문서에 쓸 수 있으면 누구나 role: 'admin'을
      // 써넣어 (1) 전 회원 문서(ci·di·실명·연락처 포함)를 읽고 (2) 회원 문서를
      // 삭제하고 (3) 관리자 전용 Function을 호출할 수 있다 — 서버측 권한 검증이
      // 읽는 값 자체를 공격자가 통제하게 되므로 검증이 무의미해진다.
      // 관리자 지정은 Firebase 콘솔/Admin SDK로만 한다(앱은 role을 읽기만 한다).
      function isPrivilegeFieldChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      }

      // 파생 필드(nicknameLower 등)도 인증 여부와 무관하게 항상 수정 불가.
      // signupProvider 최초 1회 기록만 위 제한들과 별개로 허용한다.
      allow update: if isSignedIn() && uid() == userId && (
        isSignupProviderFirstWrite() ||
        (isDerivedFieldOnlyChange() &&
         !isVerificationFieldChange() &&
         !isPrivilegeFieldChange())
      );

      allow delete: if isAdmin();
    }

    // ── parties 컬렉션 ─────────────────────────────────────────────────
    // 파라미터 변조 방지 설계:
    //
    //   [읽기]
    //   - 비로그인 사용자도 목록·상세 조회 가능 (공개 컬렉션)
    //
    //   [생성]
    //   - 로그인된 사용자만 생성 가능
    //   - hostId는 반드시 자신의 auth.uid와 일치해야 함 (타인 사칭 방지)
    //
    //   [수정]
    //   - 파티장만: hostId·createdAt 제외 모든 필드 수정 가능
    //     (승인/거절, 모집상태, 파티 정보 수정)
    //   - 참가 신청은 클라이언트가 직접 쓸 수 없다. 반드시 applyToParty /
    //     createPendingPackageBooking Function(Admin SDK)을 거쳐야 하며,
    //     거기서 모집상태·마감시각·정원·연령·성별을 검증하고 참가비
    //     스냅샷(applications 서브컬렉션)까지 함께 기록한다.
    //     정기 파티(scheduleType: 'recurring')는 고정 recruitDeadlineAt이
    //     없으므로 서버가 recurringSchedule로 회차별 마감을 계산해 막는다
    //     (functions/partySchedule.js).
    //
    //   [삭제]
    //   - 파티장 또는 관리자만 가능
    //
    // NOTE: isVerified() 대신 isSignedIn() 사용
    //       → 본인확인이 아직 Mock 상태 (Step 6 완료 후 isVerified()로 교체 예정)
    match /parties/{partyId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.hostId == uid();

      // 파티장 경로만 허용 — hostId·createdAt은 변경 불가.
      //
      // 예전에는 신청자가 applicants 배열에 자기 uid만 추가하는 경로를
      // fallback으로 열어뒀지만, 그 경로는 마감·정원·연령·성별 검증을 전부
      // 건너뛰고 참가비 기록도 남기지 않아 제거했다. 신청은 반드시
      // applyToParty(Functions)를 거친다.
      allow update: if isSignedIn() &&
        resource.data.hostId == uid() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['hostId', 'createdAt']);

      allow delete: if isSignedIn() &&
        (resource.data.hostId == uid() || isAdmin());
    }

    // ── favorites 컬렉션 (찜) ────────────────────────────────────────
    // 문서 id: "{userId}_{type}_{itemId}" (favorites_service.dart 참고)
    // [읽기] 본인 또는 관리자만 (관리자 웹의 회원 상세 "찜 목록"에서도 사용)
    // [생성] 본인 userId로만, 문서 id가 반드시 "본인uid_type_itemId" 형식이어야 함
    // [삭제] 본인 또는 관리자만
    // [수정] 없음 — 찜은 생성/삭제만 존재, 필드 변경 개념이 없음
    //
    // ⚠️ 읽기는 get(문서 하나)과 list(컬렉션 쿼리)를 **반드시 나눠야 한다.**
    // 둘을 read 하나로 묶으면 둘 중 하나는 반드시 깨진다.
    //
    // · get  — 문서 id(favoriteId)로만 판별한다. 아직 없는 문서를 get()/
    //   snapshots()로 읽으면 resource가 null이라, resource.data를 참조하는
    //   규칙은 평가 자체가 실패해 항상 PERMISSION_DENIED가 난다. 찜 버튼은
    //   watchFavorited()로 없는 문서를 구독하고 toggleFavorite()도 매번
    //   get()으로 존재 여부를 먼저 확인하므로, resource.data를 참조하면
    //   모든 최초 찜 시도가 실패한다.
    //
    // · list — 반대로 문서 id로 판별할 수 없다. 컬렉션 쿼리는 "이 쿼리가
    //   돌려줄 수 있는 문서가 전부 규칙을 통과하는가"로 평가되는데, 쿼리에는
    //   문서 id 제약이 없어서 favoriteId 패턴 조건을 만족시킬 방법이 없다.
    //   그래서 read를 id 기반으로 통일했을 때 관심 목록 화면의
    //   watchFavoritesByType() 쿼리가 통째로 PERMISSION_DENIED가 났다
    //   ("찜은 눌리는데 관심 목록에는 아무것도 안 뜬다"의 원인). list는
    //   클라이언트가 이미 where('userId','==',uid)로 거르고 있으므로
    //   resource.data.userId로 판별한다(list는 실제 결과 문서에 대해
    //   평가되므로 resource가 null일 수 없다).
    match /favorites/{favoriteId} {
      allow get: if isSignedIn() &&
        (favoriteId.matches(uid() + '_.*') || isAdmin());

      allow list: if isSignedIn() &&
        (resource.data.userId == uid() || isAdmin());

      allow create: if isSignedIn() &&
        request.resource.data.userId == uid() &&
        favoriteId == uid() + '_' + request.resource.data.type + '_' + request.resource.data.itemId;

      allow update: if false;

      allow delete: if isSignedIn() &&
        (favoriteId.matches(uid() + '_.*') || isAdmin());
    }

    // ── parties/{partyId}/applications 서브컬렉션 (신청 상태 추적) ─────
    // 문서 id: 신청자 uid (파티당 1인 1문서).
    // applyToParty Cloud Function이 신청 시점에 status='applied'로 생성하고,
    // 이후 승인/거절/실제참석/취소/노쇼 전환은 관리자 전용 Functions
    // 콜러블에서만 처리한다 (2단계에서 구현).
    // [읽기] 신청자 본인, 해당 파티 호스트, 관리자
    // [쓰기] 클라이언트 직접 쓰기 전면 차단 — Functions Admin SDK 전용
    //        (verificationSessions 컬렉션과 동일한 보호 패턴)
    //
    // 호스트 판정은 신청서 자신의 hostId를 **먼저** 본다. 결제가 있었던
    // 신청서는 거래기록이라 파티를 삭제해도 남는데(contentCleanup.js),
    // 그때 부모 파티 문서가 없어 get()이 null이 되면 규칙 평가 자체가
    // 실패해 호스트가 자기 거래내역을 못 읽게 된다. ||는 앞이 참이면
    // 뒤를 평가하지 않으므로, hostId가 있는 문서는 get()까지 가지 않는다
    // (get()은 hostId가 없던 옛 신청서용 폴백으로만 남긴다).
    match /parties/{partyId}/applications/{applicationId} {
      allow read: if isSignedIn() && (
        resource.data.uid == uid() ||
        resource.data.get('hostId', '') == uid() ||
        get(/databases/$(database)/documents/parties/$(partyId)).data.hostId == uid() ||
        isAdmin()
      );
      allow write: if false;
    }

    // ── applications 컬렉션 그룹 조회 ────────────────────────────────────
    // 마이페이지 "참가"(개수 뱃지 + 목록)는 collectionGroup('applications')로
    // 내 uid가 걸린 신청서를 파티 전체에서 한 번에 긁어온다
    // (my_page_screen.dart의 _MyJoinedPartyList).
    //
    // **위의 /parties/{partyId}/applications/{applicationId} 규칙은 컬렉션 그룹
    // 쿼리에 적용되지 않는다** — Firestore는 중첩 경로로 명시한 규칙을 컬렉션
    // 그룹 쿼리에 쓰지 않고, 재귀 와일드카드(`/{path=**}/applications/{id}`)로
    // 따로 선언한 규칙만 본다. 이 규칙이 없어서 참가 조회가 통째로
    // permission-denied로 떨어졌고, 개수는 0개로 목록은 무한 로딩으로 보였다.
    //
    // 권한 범위는 위 규칙과 같다(본인 신청서 · 그 파티 호스트 · 관리자).
    // 다만 여기서는 경로에 partyId가 없어 부모 파티를 get()으로 되짚을 수
    // 없으므로, 호스트 판정은 신청서에 저장된 hostId만 쓴다 — hostId가 없던
    // 옛 신청서를 호스트가 읽는 경로는 위의 문서 경로 규칙이 그대로 담당한다
    // (두 규칙은 OR로 평가되므로 이 규칙을 추가해도 기존 접근이 좁아지지 않는다).
    match /{path=**}/applications/{applicationId} {
      allow read: if isSignedIn() && (
        resource.data.uid == uid() ||
        resource.data.get('hostId', '') == uid() ||
        isAdmin()
      );
      allow write: if false;
    }

    // ── reports 컬렉션 (신고) ────────────────────────────────────────
    // 파티/사용자/장소/파티샵/크루 신고 — feedbackRequests(의견 보내기)와는
    // 별개의 전용 컬렉션. 현재는 제출 UI가 없어 스키마·권한만 선반영한다.
    // [읽기] 작성자 본인 또는 관리자
    // [생성] 로그인된 사용자가 자신의 reporterId로만, 초기 상태는 'received'
    // [수정] 관리자만, status/adminMemo/updatedAt/resolvedAt 외 필드 변경 불가
    // [삭제] 관리자만
    match /reports/{reportId} {
      allow read: if isSignedIn() &&
        (resource.data.reporterId == uid() || isAdmin());

      allow create: if isSignedIn() &&
        request.resource.data.reporterId == uid() &&
        request.resource.data.status == 'received';

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'adminMemo', 'updatedAt', 'resolvedAt'
        ]);

      allow delete: if isAdmin();
    }

    // ── userStats 컬렉션 (사용자별 요약 이용 통계) ──────────────────────
    // 문서 id = uid. 원본 기록(parties/{id}/applications, favorites,
    // analyticsEvents)과 분리된 집계 전용 문서 — Functions만 기록한다.
    // [읽기] 본인 또는 관리자만 (일반 사용자는 자신의 통계만 조회 가능)
    // [쓰기] 클라이언트 직접 불가 — onApplicationStatusWrite/onFavoriteWrite/
    //        onAnalyticsEventCreated/onUserFieldsWrite Functions에서만 갱신
    match /userStats/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isAdmin());
      allow write: if false;
    }

    // ── systemFunctionErrors 컬렉션 (스케줄 함수 실패 기록) ──────────────
    // logScheduledFunctionError(memberActivityHelpers.js)가 Admin SDK로만
    // 기록한다 — 관리자 웹 대시보드/시스템 오류 화면에서 조회용.
    // [읽기] 관리자만 [쓰기] 클라이언트 직접 불가
    match /systemFunctionErrors/{errorId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── analyticsEvents 컬렉션 (행동 로그) ──────────────────────────────
    // 사업적으로 의미 있는 조회/행동 이벤트만 기록하는 불변 로그.
    // CI/DI/휴대폰번호 등 민감정보는 이 컬렉션에 절대 저장하지 않는다.
    // 실시간 위치는 저장하지 않고, 사용자가 실제로 본 파티/장소의 지역만 담는다.
    // [읽기] 본인 또는 관리자만
    // [생성] 로그인된 사용자가 자신의 userId로만, 정의된 이벤트 타입만,
    //        occurredAt은 서버 타임스탬프여야 함(클라이언트가 시각 위조 불가)
    // [수정·삭제] 불가 — 불변 로그
    match /analyticsEvents/{eventId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());

      allow create: if isSignedIn() &&
        request.resource.data.userId == uid() &&
        request.resource.data.occurredAt == request.time &&
        request.resource.data.eventType in [
          'app_open', 'party_view', 'party_search', 'party_favorite_add',
          'party_favorite_remove', 'party_apply', 'party_cancel', 'party_attended',
          'party_create', 'party_share', 'place_view', 'place_reservation'
        ];

      allow update, delete: if false;
    }

    // ── dailyStats / regionStats / hourlyStats (전역 집계) ──────────────
    // 관리자 전용 통계 문서 — 본인확인 정보와 마찬가지로 관리자만 조회 가능.
    // 전부 Functions가 FieldValue.increment()로만 갱신한다.
    match /dailyStats/{dateId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /regionStats/{regionId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /hourlyStats/{hourId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── userActivityLogs (통합 활동 타임라인) ───────────────────────────
    // 회원 상세 페이지의 "통합 활동 타임라인"용 — 가입/로그인/파티·플레이스
    // ·상품·크루 등록/신청·승인·취소/찜/공유/관리자 상태변경 등을 uid와
    // 함께 기록한다. 전부 memberManagement.js의 트리거/onCall이 Admin SDK로만
    // 기록하며, 클라이언트는 본인 것 또는 관리자만 읽을 수 있다.
    match /userActivityLogs/{logId} {
      allow read: if isSignedIn() && (resource.data.uid == uid() || isAdmin());
      allow write: if false;
    }

    // ── reservations 컬렉션 ───────────────────────────────────────────
    // 파라미터 변조 방지 설계:
    //
    //   [읽기] 본인 예약만 조회 가능
    //
    //   [생성] 클라이언트 생성 허용 (장소 예약 기능), 단 아래 조건 강제:
    //   - userId 반드시 자신의 auth.uid와 일치 (타인 위장 방지)
    //   - paymentStatus는 반드시 'pending' (결제 완료 상태 위조 방지)
    //   - reservationStatus는 반드시 'pending'
    //   - totalPrice는 장소의 pricePerHour × durationHours와 일치해야 함
    //     (클라이언트에서 임의 금액 저장 방지)
    //
    //   [수정·삭제] 클라이언트 직접 불가
    //   - paymentStatus 업데이트는 결제 연동 후 Firebase Functions에서만 처리
    //   - 예약 취소는 별도 Functions 엔드포인트에서 처리
    match /reservations/{reservationId} {
      allow read: if isSignedIn() && resource.data.userId == uid();

      allow create: if isSignedIn() &&
        // 본인 예약만 생성 가능
        request.resource.data.userId == uid() &&
        // 결제 완료 상태 위조 방지
        request.resource.data.paymentStatus == 'pending' &&
        request.resource.data.reservationStatus == 'pending' &&
        // totalPrice 변조 방지: places 컬렉션의 실제 가격으로 검증
        request.resource.data.totalPrice ==
          get(/databases/$(database)/documents/places/$(request.resource.data.placeId))
            .data.pricePerHour * request.resource.data.durationHours;

      allow update, delete: if false;
    }

    // ── verificationSessions 컬렉션 ──────────────────────────────────
    // 재사용 방지(Replay Prevention) 세션 저장소.
    // 문서 경로: verificationSessions/{uid} (uid당 1개 세션)
    //
    // 쓰기: Functions Admin SDK에서만 (niceIntcRequestUrl, niceIntcResult)
    //       클라이언트 직접 쓰기 차단 → sessionId 위조 불가
    // 읽기: 본인만 자신의 세션 상태(used, expiresAt) 확인 가능
    match /verificationSessions/{userId} {
      allow read: if isSignedIn() && uid() == userId;
      allow write: if false;
    }

    // ── niceAuthSessions 컬렉션 ─────────────────────────────────────────
    // NICE 통합인증 v2(niceAuth.js) 전용 세션 저장소. verificationSessions와
    // 완전히 같은 보호 패턴 — ticket/iterators가 들어 있으므로 클라이언트
    // 쓰기는 전면 차단하고, 읽기도 본인 문서로만 제한한다.
    match /niceAuthSessions/{userId} {
      allow read: if isSignedIn() && uid() == userId;
      allow write: if false;
    }

    // ── identityLinks 컬렉션 ────────────────────────────────────────────
    // "1명의 실사용자 = 파티츄 계정 1개" 정책의 CI ↔ 계정 연결 대장.
    // 문서 경로: identityLinks/{sha256(ci)} (CI 1개당 문서 1개)
    //
    // 클라이언트가 읽을 수 있으면 "이 CI가 이미 가입돼 있는지"를 해시만으로
    // 조회할 수 있게 되고(개인정보 조회 채널), 쓸 수 있으면 남의 CI를 선점하거나
    // 자기 링크를 지워 중복 가입을 뚫을 수 있다. 그래서 읽기·쓰기를 모두 막고
    // Admin SDK(niceAuthResult / niceIntcResult / adminUpdateMember /
    // backfillIdentityLinks)에서만 다룬다.
    match /identityLinks/{ciHash} {
      allow read, write: if false;
    }

    // ── places 컬렉션 ─────────────────────────────────────────────────
    // [읽기] 비로그인 사용자도 목록·상세 조회 가능 (공개 컬렉션)
    // [생성] 로그인된 사용자가 자신의 hostId로만 등록 가능
    // [수정·삭제] 장소 호스트 또는 관리자만 가능
    // ⚠ 이 문서는 **누구나 읽는다**(손님이 장소 상세를 보려면 열려 있어야
    //   한다). 그래서 여기에는 개인 계좌 같은 비공개 정보를 절대 두지 않는다.
    //
    //   예전에는 장소 등록 폼이 payoutAccount{bank, accountNumber,
    //   accountHolder}를 이 문서에 저장했다 — 호스트의 은행·계좌번호·예금주가
    //   비로그인 사용자에게까지 그대로 공개되고 있었다. 정산계좌는
    //   users/{uid}.settlementInfo(본인·관리자만 read)로 옮겼고, 아래 조건으로
    //   이 문서에 계좌가 **다시 들어오는 것 자체를** 막는다.
    function hasNoPayoutAccount() {
      return !request.resource.data.keys().hasAny(['payoutAccount']);
    }

    match /places/{placeId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.hostId == uid() &&
        hasNoPayoutAccount();

      allow update: if isSignedIn() &&
        (resource.data.hostId == uid() || isAdmin()) &&
        hasNoPayoutAccount();

      allow delete: if isSignedIn() && (
        resource.data.hostId == uid() || isAdmin()
      );
    }

    // ── placeRooms 컬렉션 ────────────────────────────────────────────
    // [읽기] 비로그인 사용자도 조회 가능 (장소 상세에서 룸 목록 표시)
    // [생성] 장소 호스트만 자신의 hostId로 등록 가능
    // [수정·삭제] 호스트 또는 관리자만 가능
    match /placeRooms/{roomId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.hostId == uid();

      allow update, delete: if isSignedIn() && (
        resource.data.hostId == uid() || isAdmin()
      );
    }

    // ── partyServices 컬렉션 ─────────────────────────────────────────
    // [읽기] 비로그인 사용자도 조회 가능 (공개 컬렉션)
    // [생성] 로그인된 사용자가 자신의 hostId로만 등록 가능
    // [수정·삭제] 호스트 또는 관리자만 가능
    match /partyServices/{serviceId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.hostId == uid();

      allow update, delete: if isSignedIn() && (
        resource.data.hostId == uid() || isAdmin()
      );
    }

    // ── crews 컬렉션 ──────────────────────────────────────────────────
    // [읽기] 비로그인 사용자도 조회 가능 (공개 컬렉션)
    // [생성] 로그인된 사용자가 자신의 hostId로만 등록 가능
    // [수정·삭제] 호스트 또는 관리자만 가능
    match /crews/{crewId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.hostId == uid();

      allow update, delete: if isSignedIn() && (
        resource.data.hostId == uid() || isAdmin()
      );
    }

    // ── partyShops 컬렉션 (파티샵) + products 서브컬렉션 ─────────────────
    // [읽기] 비로그인 사용자도 조회 가능 (공개 컬렉션)
    // [생성] 로그인된 사용자가 자신의 hostId로만 등록 가능
    // [수정·삭제] 샵 호스트 또는 관리자만 가능
    match /partyShops/{shopId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.hostId == uid();

      allow update, delete: if isSignedIn() && (
        resource.data.hostId == uid() || isAdmin()
      );

      match /products/{productId} {
        allow read: if true;

        allow create: if isSignedIn() &&
          request.resource.data.hostId == uid();

        allow update, delete: if isSignedIn() && (
          resource.data.hostId == uid() || isAdmin()
        );
      }
    }

    // ── orders 컬렉션 (파티샵 상품 주문) ───────────────────────────────
    // ⚠ 예전에는 이 컬렉션의 규칙이 아예 없었다 — 매칭되는 규칙이 없으면
    //   기본 거부이므로 클라이언트의 주문 생성은 항상 실패했고, 그 코드는
    //   결제 검증 없이 status:'paid'를 직접 쓰려 하고 있었다.
    //
    // 이제 결제가 걸린 다른 흐름(placeReservationGroups / packageBookings /
    // placeProductOrders)과 동일하게 **Functions 전용**으로 못박는다. 주문
    // 생성·확정·취소는 전부 Admin SDK를 쓰는 Cloud Functions에서만 일어나고,
    // 결제 금액/상태는 서버가 PortOne에 직접 조회해 검증한다. 클라이언트는
    // 자기 주문(구매자) 또는 자기 샵 주문(판매자)만 읽을 수 있다.
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.sellerId == uid() ||
        isAdmin()
      );

      allow write: if false;
    }

    // ── placeProducts 컬렉션 (플레이스 공통 상품·이용권) ────────────────
    // 술집·바·카페(events)와 공간대여·숙박(places)이 같은 구조를 공유한다.
    // 어느 쪽 플레이스인지는 문서의 placeCollection 필드로 구분한다.
    //
    // [읽기] 공개 — 플레이스 상세의 '상품·이용권' 목록에 쓰인다.
    // [생성] 본인 hostId로만. 판매 수량(soldCount)은 반드시 0에서 시작한다.
    // [수정] 호스트/관리자. 단 soldCount·hostId는 못 바꾼다 — 판매 수량은
    //        결제 확정 시 Functions만 올리는 값이라, 여기서 손댈 수 있으면
    //        재고를 되돌려 무한히 팔 수 있게 된다.
    // [삭제] 한 개라도 팔린 상품은 삭제할 수 없다 — 이미 발급된 이용권이
    //        가리킬 상품이 사라지면 QR 검증이 불가능해진다. 판매를 멈추려면
    //        manuallyStopped(판매 중지)를 쓴다.
    match /placeProducts/{productId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.hostId == uid() &&
        request.resource.data.soldCount == 0;

      allow update: if isSignedIn() &&
        (resource.data.hostId == uid() || isAdmin()) &&
        request.resource.data.soldCount == resource.data.soldCount &&
        request.resource.data.hostId == resource.data.hostId;

      allow delete: if isSignedIn() &&
        (resource.data.hostId == uid() || isAdmin()) &&
        resource.data.soldCount == 0;
    }

    // ── placeProductOrders 컬렉션 (상품 주문 = QR 이용권) ───────────────
    // 결제·사용 처리 전 구간이 Functions 전용이다(placeBookings와 같은 정책).
    // 클라이언트가 직접 쓸 수 있으면 '사용 가능' 상태나 결제 금액을 위조해
    // 이용권을 무한히 만들거나 되살릴 수 있다.
    //
    // [읽기] 구매자 본인, 해당 상품의 판매자(호스트), 관리자.
    //        사장님이 QR을 스캔해 주문을 확인하는 경로도 이 읽기 권한을 쓴다.
    // [쓰기] 전면 차단 — createPendingProductOrder / verifyAndConfirmProductOrder
    //        / cancelProductOrder / redeemProductVoucher / expireStaleProductOrders
    match /placeProductOrders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.hostId == uid() ||
        isAdmin()
      );

      allow write: if false;
    }

    // ── placeMenus 컬렉션 (매장 메뉴) ────────────────────────────────────
    // "하이볼 8,000원"처럼 매장에서 시켜 먹는 것만 담는다. 앱에서 결제하는
    // 이용권은 placeProducts이고, 여기에는 재고·주문·QR이 아예 없다.
    //
    // 결제가 걸리지 않으므로 placePromotions와 **완전히 같은 정책**을 쓴다.
    //
    // [읽기] 공개 — 플레이스 상세에서 손님에게 보여준다.
    // [생성] 본인 hostId로만.
    // [수정·삭제] 호스트 또는 관리자. hostId는 바꿀 수 없다(남의 플레이스
    //             메뉴로 옮겨 붙이는 걸 막는다).
    match /placeMenus/{menuId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.hostId == uid();

      allow update: if isSignedIn() &&
        (resource.data.hostId == uid() || isAdmin()) &&
        request.resource.data.hostId == resource.data.hostId;

      allow delete: if isSignedIn() &&
        (resource.data.hostId == uid() || isAdmin());
    }

    // ── placePromotions 컬렉션 (매장 이벤트·프로모션) ────────────────────
    // "오늘 혼술 환영", "직장인 할인"처럼 **결제가 없는 홍보**만 담는다.
    // 결제가 걸리는 내용은 placeProducts로 등록하고, 프로모션에서는
    // linkedProductIds로 연결만 한다.
    //
    // 재고·주문·이용권이 없어 서버 함수를 거칠 이유가 없으므로, 다른 공개
    // 등록물(events·placeRooms·partyServices)과 같은 단순 정책을 쓴다.
    //
    // [읽기] 공개 — 플레이스 상세에서 보여준다.
    // [생성] 본인 hostId로만.
    // [수정·삭제] 호스트 또는 관리자. hostId는 바꿀 수 없다(남의 플레이스
    //             프로모션으로 옮겨 붙이는 걸 막는다).
    match /placePromotions/{promotionId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.hostId == uid();

      allow update: if isSignedIn() &&
        (resource.data.hostId == uid() || isAdmin()) &&
        request.resource.data.hostId == resource.data.hostId;

      allow delete: if isSignedIn() &&
        (resource.data.hostId == uid() || isAdmin());
    }

    // ── events 컬렉션 (이벤트) ────────────────────────────────────────
    // [읽기] 비로그인 사용자도 조회 가능 (공개 컬렉션)
    // [생성] 로그인된 사용자가 자신의 hostId로만 등록 가능
    // [수정·삭제] 이벤트 호스트 또는 관리자만 가능
    match /events/{eventId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.hostId == uid();

      allow update, delete: if isSignedIn() && (
        resource.data.hostId == uid() || isAdmin()
      );
    }

    // ── feedbackRequests 컬렉션 (의견 보내기) ──────────────────────────
    // 파티/사용자 신고, 환불 요청, 결제 분쟁, 긴급 문의와는 완전히 분리된
    // 전용 컬렉션 — 서비스 개선 제안·버그 신고·일반 문의 전용.
    //
    // [읽기] 본인이 작성한 의견 또는 관리자만 조회 가능
    // [생성] 로그인된 사용자가 자신의 userId로만 생성, 초기 상태는 반드시
    //        status='received', userReply/adminMemo는 빈 문자열이어야 함
    //        (접수 전부터 답변이 달린 것처럼 위조하는 것 방지)
    // [수정] 일반 사용자는 절대 불가(본인 것이라도 수정 불가) — 관리자만 가능,
    //        관리자도 status/userReply/adminMemo/updatedAt 외 필드는 변경 불가
    //        (작성자·원문 내용 위변조 방지)
    // [삭제] 관리자만 가능
    match /feedbackRequests/{feedbackId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == uid() || isAdmin());

      allow create: if isSignedIn() &&
        request.resource.data.userId == uid() &&
        request.resource.data.status == 'received' &&
        request.resource.data.userReply == '' &&
        request.resource.data.adminMemo == '' &&
        request.resource.data.title is string &&
        request.resource.data.content is string &&
        request.resource.data.type in ['improvement', 'bug', 'inquiry', 'other'];

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'userReply', 'adminMemo', 'updatedAt'
        ]);

      allow delete: if isAdmin();
    }

    // ── appConfig 컬렉션 ──────────────────────────────────────────────
    // 앱 업데이트 정책(appConfig/version 등) 저장소.
    // [읽기] 로그인 여부와 무관하게 앱 실행 즉시(로그인 전에도) 버전을 확인해야
    //        하므로 전체 공개 읽기 허용 — 민감정보 없음(버전/스토어 URL뿐).
    // [쓰기] 관리자만 — 코드 배포 없이 값만 바꿔 정책을 바꾸는 용도이므로
    //        일반 사용자가 조작할 수 없어야 한다.
    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── places/{placeId}/reservationSlots 서브컬렉션 (장소대여 예약 — 공개) ──
    // 개인정보를 절대 담지 않는 "예약 가능 여부 확인용" 문서다 — 필드는
    // roomId/groupId/startAt/endAt/status/expiresAt 뿐(placeReservations.js
    // createPendingReservation 참고). 예약자 이름·연락처·인원·가격 등은 전부
    // placeReservationGroups(비공개)에만 있다.
    // [읽기] 개인정보가 없으므로 누구나 조회 가능(비로그인 이용자도 장소
    //        상세를 볼 수 있는 것과 동일한 공개 수준 — places 컬렉션 규칙 참고).
    // [쓰기] createPendingReservation/verifyAndConfirmReservation/
    //        cancelReservation/expireStalePlaceReservations Admin SDK 전용.
    match /places/{placeId}/reservationSlots/{slotId} {
      allow read: if true;
      allow write: if false;
    }

    // ── placeReservationGroups 컬렉션 (장소대여 예약 1건 단위 — 비공개) ─────
    // 시간제(여러 슬롯)/패키지/하루단위 예약 1건을 대표하는 그룹 문서 —
    // 포트원 paymentId로 그대로 쓰인다. 예약자 이름·연락처·인원·결제금액 등
    // 개인정보/영업정보를 전부 담고 있으므로 본인·해당 장소 호스트·관리자만
    // 읽을 수 있다.
    // [읽기] 예약자 본인(requesterId), 해당 장소 호스트(hostId), 관리자만.
    // [쓰기] 클라이언트 직접 불가 — placeReservations.js Admin SDK 전용
    //        (결제 검증 없이 확정 상태를 위조할 수 없도록 전면 차단).
    match /placeReservationGroups/{groupId} {
      allow read: if isSignedIn() &&
        (resource.data.requesterId == uid() ||
         resource.data.hostId == uid() ||
         isAdmin());
      allow write: if false;
    }

    // ── events/{placeId}/visitSlots 서브컬렉션 (플레이스 방문 예약 — 공개) ───
    // 무료 방문 예약이 시간대별로 **몇 명 잡혔는지**만 담은 문서다 — 필드는
    // date/startAt/endAt/capacity/reservedPeople 뿐(placeVisitReservations.js
    // 참고). 예약자 이름·연락처·요청사항은 전부 placeVisitReservations
    // (비공개)에만 있다.
    // [읽기] 개인정보가 없고, 예약 화면이 "이 시간 자리 있나"를 보여주려면
    //        필요하다 — 장소대여의 reservationSlots와 같은 공개 수준.
    // [쓰기] createVisitReservation/decideVisitReservation/
    //        cancelVisitReservation/expireStaleVisitReservations Admin SDK 전용.
    match /events/{placeId}/visitSlots/{slotId} {
      allow read: if true;
      allow write: if false;
    }

    // ── placeVisitReservations 컬렉션 (플레이스 방문 예약 1건 — 비공개) ──────
    // 결제가 없는 "방문 요청" 1건 — 유료 좌석 상품(placeProductOrders)이나
    // 장소대여 공간 예약(placeReservationGroups)과는 별개 기능이다. 예약자
    // 이름·연락처·요청사항을 담고 있으므로 본인·해당 매장 업주·관리자만 읽는다.
    // [읽기] 예약자 본인(requesterId), 매장 업주(hostId), 관리자만.
    // [쓰기] 클라이언트 직접 불가 — placeVisitReservations.js Admin SDK 전용
    //        (승인 상태나 정원을 클라이언트가 위조할 수 없도록 전면 차단).
    match /placeVisitReservations/{reservationId} {
      allow read: if isSignedIn() &&
        (resource.data.requesterId == uid() ||
         resource.data.hostId == uid() ||
         isAdmin());
      allow write: if false;
    }

    // ── packageBookings 컬렉션 (숙박+파티 패키지 예약 1건 단위 — 비공개) ────
    // placeReservationGroups와 동일한 보호 패턴 — 방 예약 + 파티 신청을
    // 하나로 묶은 패키지 예약 문서. 예약자 이름·연락처·인원·결제금액 등
    // 개인정보/영업정보를 전부 담고 있으므로 본인·해당 장소 호스트·관리자만
    // 읽을 수 있다.
    // [읽기] 예약자 본인(requesterId), 해당 장소 호스트(hostId), 관리자만.
    // [쓰기] 클라이언트 직접 불가 — packageBookings.js Admin SDK 전용
    //        (결제 검증 없이 확정 상태를 위조할 수 없도록 전면 차단).
    match /packageBookings/{bookingId} {
      allow read: if isSignedIn() &&
        (resource.data.requesterId == uid() ||
         resource.data.hostId == uid() ||
         isAdmin());
      allow write: if false;
    }

    // ── placeBookings 컬렉션 ──────────────────────────────────────────
    // [읽기] 로그인된 사용자라면 예약 슬롯 현황 조회 가능
    //        (placeId 기준 쿼리로 예약된 시간대 확인)
    //        개인정보(requesterName 등)는 추후 Functions 엔드포인트로 분리 예정
    // [생성] 본인 예약만 생성 가능, 초기 상태 위조 방지
    // [수정·삭제] 클라이언트 직접 불가 (취소·상태 변경은 Functions에서 처리)
    match /placeBookings/{bookingId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.userId == uid() &&
        request.resource.data.paymentStatus == 'pending' &&
        request.resource.data.bookingStatus == 'pending';

      allow update, delete: if false;
    }

    // ── drafts 컬렉션 (등록 화면 임시저장 — 비공개) ────────────────────────
    // 문서 id = "{userId}__{type}" (사용자별·등록유형별 1개 고정). 본인만
    // 조회·생성·수정·삭제할 수 있는 완전 비공개 컬렉션 — 목록/검색에 절대
    // 노출되지 않는다.
    //
    // read/delete는 아직 존재하지 않는 문서를 get()/snapshots()로 확인할 때
    // resource가 null이 되어 규칙 평가가 실패하는 것을 피하기 위해, favorites와
    // 같은 방식으로 소유권을 resource.data가 아니라 문서 id 접두어로 판정한다.
    match /drafts/{draftId} {
      allow read, delete: if isSignedIn() && draftId.matches(uid() + '__.*');

      allow create, update: if isSignedIn() &&
        request.resource.data.userId == uid() &&
        draftId == uid() + '__' + request.resource.data.type;
    }

    // 알림 — 서버(Cloud Functions)만 쓰고, 본인 것만 읽는다.
    // 지금은 최소 모집 인원 미달 자동 취소 안내가 여기 쌓인다.
    // 읽음 표시(read)만 본인이 바꿀 수 있고 내용은 못 고친다.
    match /notifications/{notificationId} {
      allow read, delete: if isSignedIn() && resource.data.uid == uid();

      allow update: if isSignedIn() &&
        resource.data.uid == uid() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read']);

      // 생성은 서버 전용(Admin SDK는 규칙을 우회한다).
      allow create: if false;
    }

    // ── chatRooms (1:1 문의 채팅) ───────────────────────────────────────────
    // 파티샵·플레이스·파티크루 글의 "채팅하기"로 열리는 방. 참가자는 항상 두
    // 명(hostId, guestId)이고 participants 배열에 그 둘이 들어간다.
    //
    // 이 컬렉션에는 지금까지 규칙이 **아예 없었다** → 기본 거부라 채팅 기능
    // 전체(목록·방 열기·메시지 전송)가 PERMISSION_DENIED로 죽어 있었다.
    // 채팅 목록 화면이 그 실패를 "아직 채팅이 없습니다"로 보여주고 있어서
    // 겉으로는 그냥 대화가 없는 것처럼 보였다.
    //
    // 소유권은 participants 배열 하나로만 판정한다 — 방 문서를 읽을 수 있는
    // 사람 = 그 방의 참가자.
    match /chatRooms/{roomId} {
      // 단건 조회(방 상태 확인)와 목록 조회(내 채팅 목록, 기존 방 찾기) 모두
      // 같은 조건이다. 목록 쿼리는 participants array-contains 나 로 제한돼
      // 있어야만 통과한다 — 필터 없는 전체 조회는 여기서 걸러진다.
      allow get, list: if isSignedIn() && uid() in resource.data.participants;

      // 방을 여는 쪽은 언제나 문의/예약하는 사람(guest)이다 — 앱의 세 경로
      // (파티크루 문의·파티샵 주문·장소 예약)가 전부 그렇다. 그래서 guestId를
      // 내 uid로 못 박는다: 남의 두 사람짜리 방을 대신 만들어 둘 수도, 내가
      // 호스트인 척 방을 만들어 둘 수도 없다.
      //
      // participants는 정확히 [hostId, guestId] 두 사람이어야 한다. 이 두 줄이
      // 없으면 participants에 나를 넣어둔 채 hostId만 남으로 바꾼 방을 만들어
      // 그 사람 이름이 걸린 대화창을 위조할 수 있다.
      allow create: if isSignedIn() &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.guestId == uid() &&
        request.resource.data.guestId in request.resource.data.participants &&
        request.resource.data.hostId in request.resource.data.participants;

      // 메시지를 보낼 때 목록 미리보기만 갱신한다(ChatService.sendMessage 배치).
      // participants·hostId 같은 소속 필드는 못 건드린다 — 만든 뒤에 남을
      // 방에 자신을 끼워 넣는 우회를 막는다.
      allow update: if isSignedIn() &&
        uid() in resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt']);

      // 방 삭제는 아직 앱에 없다 — 열어두지 않는다.
      allow delete: if false;

      match /messages/{messageId} {
        function room() {
          return get(/databases/$(database)/documents/chatRooms/$(roomId)).data;
        }

        allow read: if isSignedIn() && uid() in room().participants;

        // 보내는 사람은 **언제나 나 자신**이다.
        //
        // 예전에는 여기가 "이 방의 참가자 중 하나"까지만 요구했다. 자동 안내
        // 문구를 게스트 기기가 호스트 이름으로 대신 써야 했기 때문이다
        // (옛 ChatService.flushPendingAutoMessages). 그 느슨함 때문에 참가자 A가
        // 참가자 B의 uid로 아무 말이나 남길 수 있었다 — 대화 상대가 하지 않은
        // 약속·계좌·취소 통보를 위조할 수 있는 구멍이다.
        //
        // 자동 안내는 이제 서버(Admin SDK, functions/chatAutoMessages.js)에서만
        // 만들어진다. Admin SDK는 이 규칙을 우회하므로 여기서는 클라이언트만
        // 생각하면 되고, 그래서 senderId를 uid()로 그냥 못 박을 수 있다.
        //
        // isAuto도 함께 막는다 — 사람이 친 말이 호스트의 자동 안내인 척
        // (말풍선 위 '자동 안내' 배지) 보이게 만들 수 없다.
        allow create: if isSignedIn() &&
          uid() in room().participants &&
          request.resource.data.senderId == uid() &&
          request.resource.data.get('isAuto', false) == false &&
          request.resource.data.text is string &&
          request.resource.data.keys()
            .hasOnly(['senderId', 'senderName', 'text', 'isAuto', 'createdAt']);

        // 보낸 말은 고치거나 지울 수 없다.
        allow update, delete: if false;
      }
    }

    // ── refundRequests (환불 요청 큐) ───────────────────────────────────────
    // 참가자가 무통장입금 건을 취소해 **돌려줄 돈이 생겼을 때** 서버가 만드는
    // 문서. 자동 송금이 없어 운영자가 손으로 보내고, 보낸 뒤 상태를 넘긴다.
    //
    // 문서 안에는 **참가자의 환불계좌 사본**(은행·계좌번호·예금주)이 들어 있다.
    // 그래서 읽기를 본인과 관리자로만 좁힌다 — 호스트도 남의 계좌를 볼 이유가
    // 없다(정산은 파티츄가 하지 호스트가 참가자에게 직접 보내지 않는다).
    //
    // 쓰기는 전부 서버(Admin SDK)다: 접수는 cancelApplication이, 완료/반려는
    // completeRefundRequest가 한다. 클라이언트가 쓸 수 있으면 환불액이나
    // 처리 상태를 스스로 조작할 수 있다.
    match /refundRequests/{requestId} {
      allow get: if isSignedIn() &&
        (resource.data.requesterId == uid() || isAdmin());
      // 목록은 "내 것만" 또는 관리자 전체. 필터 없는 조회는 여기서 걸러진다.
      allow list: if isSignedIn() &&
        (resource.data.requesterId == uid() || isAdmin());

      allow create, update, delete: if false;
    }

    // ── pendingAutoMessages (자동 안내 발송 대기열) ─────────────────────────
    // 서버 내부 큐다. 호스트가 글에 적어둔 안내 문구를 "언제, 어느 방에, 누구
    // 이름으로" 내보낼지가 담긴다.
    //
    // 앱은 이 컬렉션을 직접 만지지 않는다 — scheduleChatAutoMessage /
    // flushChatAutoMessages onCall만 부르고, 실제 읽기·쓰기·발송은 Admin SDK가
    // 규칙을 우회해서 한다(functions/chatAutoMessages.js).
    //
    // 여기를 열면 senderId 강제가 무의미해진다: 큐에 남의 uid를 hostId로 적은
    // 문서를 하나 넣어두고 발송을 시키면, 서버가 그 사람 이름으로 메시지를
    // 만들어 주기 때문이다. 그래서 클라이언트 접근은 전부 막는다.
    match /pendingAutoMessages/{pendingId} {
      allow read, write: if false;
    }
  }
}
