rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 함수 ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // ── 탈퇴 대기 계정 차단 ────────────────────────────────────────────
    // 탈퇴를 신청하면 7일간 '탈퇴 대기'가 되고 그동안 서비스를 쓸 수 없다.
    // 대기 중에 새 신청·예약·등록이 생기면 7일 뒤 삭제가 다시 막히고, 사용자
    // 입장에서는 "탈퇴했는데 왜 아직 되냐"가 된다. 그래서 읽기는 그대로 두고
    // 새로 만드는 것만 막는다 — 이미 있는 내 기록은 대기 중에도 볼 수 있어야
    // 취소할지 판단할 수 있기 때문이다.
    //
    // accountStatus는 서버만 쓸 수 있는 필드라(users 규칙의
    // isDerivedFieldOnlyChange) 클라이언트가 이 판정을 비켜갈 수 없다.
    function isWithdrawalPending() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(uid())) &&
        get(/databases/$(database)/documents/users/$(uid()))
          .data.get('accountStatus', 'active') == 'withdrawal_pending';
    }

    /// 로그인했고 탈퇴 대기가 아닌 상태.
    ///
    /// 콘텐츠 등록·예약처럼 **새로 만드는** 경로에는 이것만으로 부족하다 —
    /// 그쪽은 아래 [isVerifiedMember]를 쓴다. 이 함수는 즐겨찾기·신고·채팅처럼
    /// 이미 회원 화면 안에서만 닿을 수 있는 경로에 남아 있다.
    function isActiveMember() {
      return isSignedIn() && !isWithdrawalPending();
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    /// 본인확인 완료 여부 — 회원 기능의 전제 조건.
    ///
    /// 두 필드 모두 아래 users 규칙에서 클라이언트 쓰기가 막혀 있어
    /// Admin SDK(niceAuthResult / niceIntcResult)만 기록한다. 그래서 이
    /// 판정은 위조되지 않는다. `verifiedAt` 같은 시각 필드는 인증 근거로
    /// 쓰지 않는다(functions/identityGuard.js 상단 주석 참고 — 서버 콜러블과
    /// 같은 기준이다).
    ///
    /// users 문서가 아직 없는 계정에서는 get()이 null을 돌려주고 .data 접근이
    /// 오류가 되어 규칙 평가 전체가 거부된다. exists()로 먼저 걸러
    /// '문서 없음 = 미인증'으로 확정한다(isBusinessVerified와 같은 처리).
    function isVerified() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(uid())) &&
        (userDoc(uid()).data.get('identityVerified', false) == true ||
         userDoc(uid()).data.get('isVerified', false) == true);  // 하위 호환
    }

    /// 새 콘텐츠·예약을 만들 수 있는 조건 — 로그인 + 미탈퇴 + **본인확인 완료**.
    ///
    /// 앱은 루트 게이트(party_app/lib/utils/root_gate.dart)로 미인증 계정을
    /// 서비스 화면에 들여보내지 않지만, 규칙은 구버전 앱과 SDK 직접 호출까지
    /// 상대한다 — 클라이언트가 직접 쓰는 등록 경로의 마지막 방어선이 여기다.
    function isVerifiedMember() {
      return isActiveMember() && isVerified();
    }

    function isAdmin() {
      return isSignedIn() && userDoc(uid()).data.role == 'admin';
    }

    // 사업자 권한 여부 — 예약/오픈 권한의 유일한 근거다.
    //
    // ⚠️ **두 축을 모두 본다.** status만 보면 부족하다.
    //
    //   status        국세청이 확인한 '사업자 정보의 진위'
    //   authorization 이 계정이 그 사업자를 '쓸 수 있는 권한'
    //
    // 사업자등록번호·대표자명·개업일자는 사업자등록증 사본 한 장에 전부 적혀
    // 있으므로 status만으로는 '남의 사업자등록증을 주운 사람'도 통과한다.
    // authorization == 'self'는 서버가 NICE 본인확인 실명과 국세청이 확인한
    // 대표자명을 대조하고, 사업자번호 점유까지 성공했을 때만 기록한다
    // (functions/businessVerification.js의 decideAuthorization).
    //
    // authorization == 'delegated'는 그 사업자의 대표자가 NICE 본인확인을
    // 마친 뒤 이 계정에 운영 권한을 명시적으로 부여했다는 뜻이다
    // (functions/businessDelegation.js). 근거 문서 id(delegationId)가
    // 함께 적혀 있어야만 인정한다 — 그 둘은 항상 같이 쓰이므로, id가 빈
    // 'delegated'는 어떤 정상 경로로도 만들어지지 않는다.
    //
    // ⚠️ **authorization이 없는 문서를 봐주는 예외는 두지 않는다.** 예외를
    //    하나 두면 '그 필드를 안 쓰면 통과'가 되어 이 판정이 무력해진다.
    //    서버의 isBusinessAuthorized()와 조건이 글자 그대로 같아야 하므로,
    //    한쪽을 고칠 때는 반드시 다른 쪽도 같이 본다.
    //
    // settlementInfo.hostType('개인'/'사업자')은 정산 화면에서 사용자가 직접
    // 고르는 값이라 권한 판정에 쓸 수 없다(아무나 '사업자'를 고를 수 있다).
    // 이 맵 전체는 아래 users 규칙에서 클라이언트 쓰기가 막혀 있어
    // verifyBusinessRegistration(Admin SDK)만 기록한다 — 그래서 두 값 모두
    // 위조되지 않는다.
    function isBusinessVerified() {
      // users 문서가 아직 없는 계정에서는 get()이 null을 돌려주고 .data 접근이
      // 오류가 되어 규칙 평가 전체가 거부된다 — 그러면 미인증 호스트의 정상
      // 경로(오픈예정 등록)까지 같이 막힌다. exists()로 먼저 걸러
      // '문서 없음 = 미인증'으로 확정한다(권한이 넓어지지 않는다).
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(uid())) &&
        userDoc(uid()).data.get(['businessVerification', 'status'], '') == 'verified' && (
          userDoc(uid()).data.get(['businessVerification', 'authorization'], '') == 'self' ||
          (
            userDoc(uid()).data.get(['businessVerification', 'authorization'], '') == 'delegated' &&
            userDoc(uid()).data.get(['businessVerification', 'delegationId'], '') is string &&
            userDoc(uid()).data.get(['businessVerification', 'delegationId'], '').size() > 0
          )
        );
    }

    // ── 부모 플레이스의 주인인가 ──────────────────────────────────────
    // 플레이스에 딸린 문서(룸·상품·이벤트)의 **공통 관문**이다.
    //
    // ⚠ `hostId == uid()`만 보면 부족하다. 자기 uid를 hostId에 넣고 **남의
    //   placeId**를 가리키는 문서를 만들 수 있는데, 손님 화면은 그 문서를
    //   placeId로만 조회하므로(place_detail_screen의 placeRooms 쿼리 등 —
    //   hostId 필터가 없다) 남의 플레이스 상세에 내 룸·상품이 그대로 붙는다.
    //   그래서 원본 플레이스 문서를 실제로 읽어 그 hostId까지 확인한다.
    //
    // 존재하지 않는 placeId도 여기서 걸린다(exists) — 부모 없는 orphan 문서를
    // 만들어 두는 길이 함께 막힌다.
    //
    // ⚠ 신규 플레이스 자체는 사업자만 만들 수 있으므로(events/places create의
    //   isBusinessVerified), 이 관문을 통과한다는 것은 **사업자 인증을 마친
    //   호스트의 플레이스**라는 뜻이기도 하다. 하위 문서에 그 조건을 다시
    //   달지 않는 이유다 — 정책 이전에 등록된 플레이스의 주인이 자기 룸·상품을
    //   못 고치게 되면 안 된다.
    function ownsSourcePlace(placeCollection, placeId) {
      return (placeCollection == 'events' || placeCollection == 'places') &&
        placeId is string && placeId.size() > 0 &&
        exists(/databases/$(database)/documents/$(placeCollection)/$(placeId)) &&
        get(/databases/$(database)/documents/$(placeCollection)/$(placeId))
          .data.hostId == uid();
    }

    /// 공간대여(`places`) 전용 축약 — placeRooms는 언제나 places에 붙는다
    /// (룸 payload에 placeCollection이 없다 — room_card.dart의 uploadAndGetData).
    function ownsPlace(placeId) {
      return ownsSourcePlace('places', placeId);
    }

    // 개인(사업자 미인증) 호스트가 **새 파티를 만들 수** 있는가.
    //
    // 지금은 준비 중이라 잠겨 있다. 열 때는 appConfig/policy 문서의
    // individualHostPartyCreateEnabled를 true로 바꾸기만 하면 되고 앱 재배포는
    // 필요 없다 — 앱도 같은 값을 읽어 진입을 막는다
    // (HostOpenPolicyService / PartyCreateEligibility).
    //
    // 문서가 없거나 값이 없으면 **잠긴 것으로 본다**(fail-closed) — 정책을 읽지
    // 못하는 상태가 곧 정책 우회가 되면 안 된다. appConfig는 공개 읽기라
    // (아래 appConfig 규칙) get()이 권한으로 실패하지는 않는다.
    //
    // ⚠️ individualHostOpeningEnabled와 **다른 값이다.** 그쪽은 "이미 만든
    // 파티의 모집을 여는가"이고 이쪽은 "파티를 만들 수 있는가"다.
    function individualPartyCreateEnabled() {
      return exists(/databases/$(database)/documents/appConfig/policy) &&
        get(/databases/$(database)/documents/appConfig/policy)
          .data.get('individualHostPartyCreateEnabled', false) == true;
    }

    // 연령 제한은 **성별별**이다 — 신청자는 자기 성별의 범위만 통과하면 된다
    // (functions/partyAgeRestriction.js가 정본이고, 실제 차단은 신청 콜러블
    //  reserveApplicantSlot이 한다). 성별 필드가 없는 기존 파티는 옛 공통
    // 범위(minBirthYear/maxBirthYear)를 남녀 모두에게 적용한다.
    //
    // 지금 이 헬퍼를 부르는 규칙은 없다(신청자 직접 쓰기 경로가 사라지면서
    // 호출부가 함께 없어졌다). 나중에 다시 쓰게 될 때를 위해 판정만 서버와
    // 같은 규칙으로 맞춰 둔다.
    function passesAgeRestriction(partyData) {
      let restricted = partyData.get('ageRestrictionEnabled', false);
      let userBirth = userDoc(uid()).data.get('birthYear', null);
      let gender = userDoc(uid()).data.get('gender', null);
      // 성별 필드가 하나라도 있으면 신규 스키마다.
      let perGender = partyData.get('maleAgeRestrictionEnabled', null) != null ||
                      partyData.get('femaleAgeRestrictionEnabled', null) != null;
      let myOn = gender == 'male'
        ? partyData.get('maleAgeRestrictionEnabled', false)
        : partyData.get('femaleAgeRestrictionEnabled', false);
      let myMin = gender == 'male'
        ? partyData.get('maleMinBirthYear', 0)
        : partyData.get('femaleMinBirthYear', 0);
      let myMax = gender == 'male'
        ? partyData.get('maleMaxBirthYear', 9999)
        : partyData.get('femaleMaxBirthYear', 9999);
      return !restricted ||
             (perGender
               // 성별을 모르면 성별별 제한은 판정할 수 없다 → 막는다.
               ? ((gender == 'male' || gender == 'female') &&
                  (myOn != true ||
                   (userBirth != null && userBirth >= myMin && userBirth <= myMax)))
               : (userBirth != null &&
                  userBirth >= partyData.get('minBirthYear', 0) &&
                  userBirth <= partyData.get('maxBirthYear', 9999)));
    }

    // (신청자 직접 쓰기 경로가 제거되면서 isApplicantUpdateOnly /
    //  onlyAddsSelfToApplicants 헬퍼도 함께 삭제됐다 — parties 규칙 주석 참고.)

    // ── users 컬렉션 ───────────────────────────────────────────────────
    // 정책:
    //   - 본인 또는 관리자만 전체 조회 가능
    //   - 본인확인 완료 후 인증 잠금 필드(gender, birthYear 등) 수정 불가
    //
    // TODO: party_applicants_screen.dart가 파티장 자격으로 신청자 name/gender를
    //       읽어야 하므로 Firebase Functions getApplicants(partyId) 엔드포인트 구현 후
    //       해당 화면을 Function 호출로 전환하면 이 규칙은 그대로 유지 가능.
    match /users/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isAdmin());

      // 관리자 웹 검색/정렬·통계 전용 파생 필드 — Functions(onUserCreated,
      // onUserFieldsWrite, onApplicationStatusWrite, onPartyCreated,
      // onPlaceCreated, memberManagement.js의 각종 트리거/adminUpdateMember)만
      // 기록한다. 클라이언트가 직접 쓸 수 있게 두면 검색 결과를 스스로
      // 조작하거나 이용 통계·호스트 여부·계정 상태·활동 배지를 위조할 수
      // 있어 본인확인 여부와 무관하게 항상 막는다.
      //
      // ⚠ nickname(원문)도 이 목록에 있다 — 클라이언트 쓰기 금지.
      //   닉네임은 중복될 수 없고(닉네임으로 사람을 찾기 때문), 중복 방지는
      //   `nicknames/{정규화}` 문서를 트랜잭션으로 선점해야만 성립한다. 앱이
      //   users 문서를 직접 쓸 수 있으면 예약 문서를 만들지 않고 이름만 바꿔
      //   넣을 수 있어 중복 방지가 통째로 무력해지고, REST로 직접 쓰면 앱의
      //   문자 검증도 지나가지 않는다. 닉네임 변경은 setNickname 콜러블 하나만
      //   한다(functions/nicknames.js).
      function isDerivedFieldOnlyChange() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'nickname',
          'nicknameLower', 'nameLower', 'emailLower', 'stats',
          'isHost', 'hostSince',
          'activityRoles',
          'accountStatus', 'accountStatusUpdatedAt', 'accountStatusUpdatedBy', 'accountStatusReason',
          'adminMemo', 'adminMemoUpdatedAt', 'adminMemoUpdatedBy',
          'isTestAccount', 'lastLoginAt'
        ]);
      }

      // 관리자 웹 "가입 경로" 통계용 — 최초 로그인 시 클라이언트가 한 번만
      // 쓸 수 있다(값이 아직 없고, 정해진 값 중 하나이며, 이 필드
      // 하나만 바뀌는 요청일 때만). 이미 값이 있으면 이후 어떤 로그인
      // 시도로도 덮어쓸 수 없다 — 최초 가입 경로를 그대로 보존한다.
      // 'apple'은 iOS Sign in with Apple(party_app/lib/utils/apple_sign_in.dart).
      function isSignupProviderFirstWrite() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signupProvider']) &&
          !('signupProvider' in resource.data) &&
          request.resource.data.signupProvider in ['google', 'kakao', 'naver', 'apple'];
      }

      // 인증 잠금 필드는 클라이언트가 최초 생성 시에도 쓸 수 없음
      // → Firebase Functions Admin SDK (niceIntcResult)에서만 저장 가능
      allow create: if isSignedIn() && uid() == userId &&
        !request.resource.data.keys().hasAny([
          'isVerified', 'identityVerified', 'identityVerifiedAt',
          'gender', 'birthYear', 'birthMonth', 'birthDay',
          'name', 'di', 'ci', 'identityCiHash',
          'verifiedAt', 'verificationProvider', 'phoneNumber',
          'profileCompleted',
          'businessVerification',
          'payoutAccount', 'payoutAccountVerification',
          'role',
          'nicknameLower', 'nameLower', 'emailLower', 'stats',
          'isHost', 'hostSince',
          'activityRoles',
          'accountStatus', 'accountStatusUpdatedAt', 'accountStatusUpdatedBy', 'accountStatusReason',
          'adminMemo', 'adminMemoUpdatedAt', 'adminMemoUpdatedBy',
          'isTestAccount', 'lastLoginAt'
        ]);

      // 인증 잠금 필드 — 본인확인 전후를 가리지 않고 클라이언트가 절대 쓸 수
      // 없다. Admin SDK(niceAuthResult / niceIntcResult)만 기록한다.
      //
      // 예전에는 "아직 미인증이면 잠금 필드도 쓸 수 있다"는 예외가 있었는데,
      // 그러면 클라이언트가 스스로 identityVerified: true와 ci를 써넣어 NICE
      // 인증을 통째로 건너뛸 수 있었다 — "1명의 실사용자 = 계정 1개" 정책은
      // CI가 서버에서만 기록될 때만 성립하므로 이 예외를 제거했다.
      // (앱은 nickname/profileImageUrl/settlementInfo/signupProvider/
      //  lastActiveAt만 쓰므로 이 강화로 깨지는 화면은 없다.)
      //
      // businessVerification도 같은 이유로 여기 들어간다 — 클라이언트가 이
      // 맵을 쓸 수 있으면 status: 'verified'를 스스로 써넣어 국세청 검증을
      // 통째로 건너뛰고 예약·오픈 권한을 가져갈 수 있다.
      //
      // payoutAccount(호스트 수취계좌)와 payoutAccountVerification(그 인증
      // 상태)도 마찬가지다. 이 계좌는 참가자에게 그대로 안내되어 **실제 송금
      // 대상**이 되므로, 클라이언트가 쓸 수 있으면 (1) 인증을 건너뛰고
      // status: 'verified'를 스스로 써넣거나 (2) 인증은 자기 계좌로 받아
      // 놓고 계좌번호만 남의 것으로 바꿔치기할 수 있다. 그래서 인증 상태만이
      // 아니라 **계좌 원문까지** 서버 전용이다(verifyPayoutAccount 콜러블).
      //
      // ⚠ settlementInfo(정산계좌)는 여기 없다 — 그쪽은 "향후 파티츄가
      //   호스트에게 보낼" 계좌라 참가자 돈이 흐르지 않고, 지금까지처럼
      //   본인이 직접 저장한다(payoutAccounts.js 상단의 계좌 3종 구분 참고).
      function isVerificationFieldChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isVerified', 'identityVerified', 'identityVerifiedAt',
          'gender', 'birthYear', 'birthMonth', 'birthDay',
          'name', 'di', 'ci', 'identityCiHash',
          'verifiedAt', 'verificationProvider', 'phoneNumber',
          'profileCompleted',
          'businessVerification',
          'payoutAccount', 'payoutAccountVerification',
          // 게스트 환불계좌의 **인증 결과**. 여기만 잠그면 충분하다 —
          // 인증 판정(refundAccountVerify.statusOf)이 이 기록의 지문과
          // 지금 refundAccount를 대조하므로, 계좌 원문을 클라이언트가 바꿔도
          // 지문이 어긋나 'required'로 떨어질 뿐 'verified'를 만들어낼 수는
          // 없다. 계좌 원문(refundAccount)까지 잠그지 않는 이유는, 취소 흐름이
          // 그 자리에 계좌를 저장하고 있어서다(index.js 취소 콜러블 ·
          // refundRequests.js 재제출) — 잠그면 그 두 경로가 즉시 깨진다.
          'refundAccountVerification'
        ]);
      }

      // 권한 필드 — 클라이언트가 절대 쓸 수 없다.
      //
      // isAdmin()도, 서버의 adminUpdateMember / backfillIdentityLinks /
      // adminUpdate* 계열 Function도 전부 users/{uid}.role 하나만 보고 관리자를
      // 판정한다. 이 필드를 본인 문서에 쓸 수 있으면 누구나 role: 'admin'을
      // 써넣어 (1) 전 회원 문서(ci·di·실명·연락처 포함)를 읽고 (2) 회원 문서를
      // 삭제하고 (3) 관리자 전용 Function을 호출할 수 있다 — 서버측 권한 검증이
      // 읽는 값 자체를 공격자가 통제하게 되므로 검증이 무의미해진다.
      // 관리자 지정은 Firebase 콘솔/Admin SDK로만 한다(앱은 role을 읽기만 한다).
      function isPrivilegeFieldChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      }

      // 파생 필드(nicknameLower 등)도 인증 여부와 무관하게 항상 수정 불가.
      // signupProvider 최초 1회 기록만 위 제한들과 별개로 허용한다.
      allow update: if isSignedIn() && uid() == userId && (
        isSignupProviderFirstWrite() ||
        (isDerivedFieldOnlyChange() &&
         !isVerificationFieldChange() &&
         !isPrivilegeFieldChange())
      );

      allow delete: if isAdmin();

      // ── devices (푸시 토큰) ───────────────────────────────────────────
      // 기기 하나당 문서 하나(문서 id = FCM 토큰). users 문서에 fcmToken
      // 필드 하나를 두면 멀티 디바이스에서 뒤에 로그인한 기기가 앞 기기의
      // 토큰을 덮어써 앞 기기가 알림을 못 받으므로 서브컬렉션으로 둔다.
      //
      // **쓰기는 전부 서버 전용이다.** 등록/해제는 registerPushToken /
      // unregisterPushToken onCall만 거친다(functions/pushTokens.js).
      // 클라이언트가 직접 쓰게 두면 계정 전환 시 "다른 사용자 밑에 남은 같은
      // 토큰"을 지울 수 없어(남의 문서라 규칙상 불가) B의 알림이 A에게도
      // 가는 구멍이 생긴다 — 그 정리를 하려고 통로를 서버로 좁혔다.
      //
      // 읽기는 본인/관리자만 — 남의 기기 토큰은 그 자체로 발송 대상 식별자다.
      match /devices/{token} {
        allow read: if isSignedIn() && (uid() == userId || isAdmin());
        allow write: if false;
      }
    }

    // ── parties 컬렉션 ─────────────────────────────────────────────────
    // 파라미터 변조 방지 설계:
    //
    //   [읽기]
    //   - 비로그인 사용자도 목록·상세 조회 가능 (공개 컬렉션)
    //
    //   [생성]
    //   - 로그인된 사용자만 생성 가능
    //   - hostId는 반드시 자신의 auth.uid와 일치해야 함 (타인 사칭 방지)
    //
    //   [수정]
    //   - 파티장만: hostId·createdAt 제외 모든 필드 수정 가능
    //     (승인/거절, 모집상태, 파티 정보 수정)
    //   - 참가 신청은 클라이언트가 직접 쓸 수 없다. 반드시 applyToParty /
    //     createPendingPackageBooking Function(Admin SDK)을 거쳐야 하며,
    //     거기서 모집상태·마감시각·정원·연령·성별을 검증하고 참가비
    //     스냅샷(applications 서브컬렉션)까지 함께 기록한다.
    //     정기 파티(scheduleType: 'recurring')는 고정 recruitDeadlineAt이
    //     없으므로 서버가 recurringSchedule로 회차별 마감을 계산해 막는다
    //     (functions/partySchedule.js).
    //
    //   [삭제]
    //   - 파티장 또는 관리자만 가능
    //
    // 등록은 isVerifiedMember() — 본인확인을 마친 회원만 파티를 만들 수 있다.
    // (예전에는 "본인확인이 Mock 상태라 isSignedIn()으로 둔다"는 임시 결정이
    //  여기 남아 있었다. NICE 연동이 끝난 뒤에도 그대로였고, 그 사이 미인증
    //  계정이 파티를 등록할 수 있었다.)
    match /parties/{partyId} {
      allow read: if true;

      // 사업자 인증을 마치지 않은 호스트는 오픈예정(preopen)으로만 등록할 수
      // 있다 — 신청·예약·결제가 전부 막힌 상태다(partyOpenState.js 참고).
      //
      // openState를 아예 안 쓰면 기본값이 'open'이라 여기서 걸린다. 즉
      // 미인증 호스트는 반드시 명시적으로 'preopen'을 써야 한다.
      // 인증 호스트는 둘 다 쓸 수 있다(사업자도 사전등록을 할 수 있어야 한다).
      //
      // hostBusinessVerified는 공개 카드/상세에 "사업자 인증 완료"를 띄우기
      // 위한 미러링 값이다. users 문서는 본인/관리자만 읽을 수 있어서 공개
      // 화면이 직접 확인할 수 없기 때문에 둔다 — 대신 실제 인증 상태와
      // 다르게 쓰지 못하도록 여기서 값을 못 박는다(사업자 원문 정보는
      // 공개 문서에 절대 쓰지 않는다 — 불리언 하나뿐이다).
      //
      // 그리고 **개인(사업자 미인증) 호스트는 지금 파티를 만들 수 없다** —
      // 준비가 끝나면 appConfig/policy의 individualHostPartyCreateEnabled를
      // true로 바꿔서 연다(individualPartyCreateEnabled 주석 참고). 앱도 같은
      // 정책을 읽어 진입을 막지만, 구버전 앱과 SDK 직접 호출까지 상대하는
      // 마지막 방어선은 여기다.
      //
      // 막는 것은 **새로 만드는 것뿐**이다 — 아래 update/delete는 그대로라
      // 이미 등록된 파티의 수정·관리·삭제는 개인 호스트도 예전과 똑같이 된다.
      allow create: if isVerifiedMember() &&
        request.resource.data.hostId == uid() &&
        (isBusinessVerified() || individualPartyCreateEnabled()) &&
        request.resource.data.get('openState', 'open') in ['open', 'preopen'] &&
        (isBusinessVerified() ||
         request.resource.data.get('openState', 'open') == 'preopen') &&
        request.resource.data.get('hostBusinessVerified', false) == isBusinessVerified();

      // 파티장 경로만 허용 — hostId·createdAt은 변경 불가.
      //
      // 예전에는 신청자가 applicants 배열에 자기 uid만 추가하는 경로를
      // fallback으로 열어뒀지만, 그 경로는 마감·정원·연령·성별 검증을 전부
      // 건너뛰고 참가비 기록도 남기지 않아 제거했다. 신청은 반드시
      // applyToParty(Functions)를 거친다.
      //
      // openState 계열도 같은 이유로 클라이언트가 못 바꾼다. 여기가 열려
      // 있으면 호스트가 앱을 거치지 않고 preopen → open으로 직접 뒤집어
      // 정책(individualHostOpeningEnabled)과 필수정보 검사를 통째로
      // 건너뛸 수 있다 — UI에서 버튼을 숨기는 것만으로는 막히지 않는다.
      // 전환은 openPartyRecruiting(Functions)만 한다.
      //
      // (dateTbd는 제외한다 — 호스트가 수정 화면에서 날짜를 채우면서 직접
      //  내려야 하는 표시용 플래그다. 날짜가 실제로 채워졌는지는 오픈 시점에
      //  서버가 partyDateTime으로 다시 확인하므로 위조해도 소용이 없다.)
      // 승인 방식·사전질문도 같은 이유로 클라이언트가 못 바꾼다. 여기가 열려
      // 있으면 "개인정보를 요구하는 질문은 등록을 막는다"가 성립하지 않는다 —
      // 앱의 검사를 거치지 않고 Firestore에 직접 쓰면 그만이기 때문이다.
      // 이 두 필드는 setPartyApplicationForm(Functions)만 쓴다.
      allow update: if isSignedIn() &&
        resource.data.hostId == uid() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['hostId', 'createdAt',
                   'openState', 'openedAt', 'openAlertsSentAt',
                   'hostBusinessVerified',
                   'applicationApprovalMode', 'applicationQuestions',
                   'requireApplicantPhotos',
                   'applicationFormUpdatedAt']);

      allow delete: if isSignedIn() &&
        (resource.data.hostId == uid() || isAdmin());
    }

    // ── favorites 컬렉션 (찜) ────────────────────────────────────────
    // 문서 id: "{userId}_{type}_{itemId}" (favorites_service.dart 참고)
    // [읽기] 본인 또는 관리자만 (관리자 웹의 회원 상세 "찜 목록"에서도 사용)
    // [생성] 본인 userId로만, 문서 id가 반드시 "본인uid_type_itemId" 형식이어야 함
    // [삭제] 본인 또는 관리자만
    // [수정] 없음 — 찜은 생성/삭제만 존재, 필드 변경 개념이 없음
    //
    // ⚠️ 읽기는 get(문서 하나)과 list(컬렉션 쿼리)를 **반드시 나눠야 한다.**
    // 둘을 read 하나로 묶으면 둘 중 하나는 반드시 깨진다.
    //
    // · get  — 문서 id(favoriteId)로만 판별한다. 아직 없는 문서를 get()/
    //   snapshots()로 읽으면 resource가 null이라, resource.data를 참조하는
    //   규칙은 평가 자체가 실패해 항상 PERMISSION_DENIED가 난다. 찜 버튼은
    //   watchFavorited()로 없는 문서를 구독하고 toggleFavorite()도 매번
    //   get()으로 존재 여부를 먼저 확인하므로, resource.data를 참조하면
    //   모든 최초 찜 시도가 실패한다.
    //
    // · list — 반대로 문서 id로 판별할 수 없다. 컬렉션 쿼리는 "이 쿼리가
    //   돌려줄 수 있는 문서가 전부 규칙을 통과하는가"로 평가되는데, 쿼리에는
    //   문서 id 제약이 없어서 favoriteId 패턴 조건을 만족시킬 방법이 없다.
    //   그래서 read를 id 기반으로 통일했을 때 관심 목록 화면의
    //   watchFavoritesByType() 쿼리가 통째로 PERMISSION_DENIED가 났다
    //   ("찜은 눌리는데 관심 목록에는 아무것도 안 뜬다"의 원인). list는
    //   클라이언트가 이미 where('userId','==',uid)로 거르고 있으므로
    //   resource.data.userId로 판별한다(list는 실제 결과 문서에 대해
    //   평가되므로 resource가 null일 수 없다).
    match /favorites/{favoriteId} {
      allow get: if isSignedIn() &&
        (favoriteId.matches(uid() + '_.*') || isAdmin());

      allow list: if isSignedIn() &&
        (resource.data.userId == uid() || isAdmin());

      allow create: if isActiveMember() &&
        request.resource.data.userId == uid() &&
        favoriteId == uid() + '_' + request.resource.data.type + '_' + request.resource.data.itemId;

      allow update: if false;

      allow delete: if isSignedIn() &&
        (favoriteId.matches(uid() + '_.*') || isAdmin());
    }

    // ── userBlocks 컬렉션 (사용자 차단) ──────────────────────────────
    // 문서 id: "{차단한사람}_{차단당한사람}" (services/block_service.dart 참고)
    //
    // [읽기] 차단한 본인 또는 관리자.
    //        ⚠️ **상대는 자기가 차단당했는지 알 수 없어야 한다.** 그래서
    //        "내가 차단당한 목록"을 찾는 조회는 어떤 형태로도 열지 않는다 —
    //        blockedId로 거는 쿼리는 list 규칙을 통과하지 못한다.
    // [생성] 본인이 차단하는 문서만. 문서 id가 "본인uid_상대uid"여야 하고,
    //        자기 자신은 차단할 수 없다.
    // [수정] 없음 — 차단은 생성/삭제만 존재한다(favorites와 같다).
    // [삭제] 차단한 본인 또는 관리자(차단 해제).
    //
    // ⚠️ get/list를 나누는 이유는 favorites 규칙 주석과 **완전히 동일하다.**
    // get은 아직 없는 문서를 읽는 일이 정상 흐름에 있어(차단 여부 확인)
    // resource.data를 보면 항상 PERMISSION_DENIED가 되고, list는 반대로 문서
    // id로 판별할 수 없다.
    match /userBlocks/{blockId} {
      allow get: if isSignedIn() &&
        (blockId.matches(uid() + '_.*') || isAdmin());

      allow list: if isSignedIn() &&
        (resource.data.blockerId == uid() || isAdmin());

      allow create: if isSignedIn() &&
        request.resource.data.blockerId == uid() &&
        request.resource.data.blockedId is string &&
        request.resource.data.blockedId != uid() &&
        blockId == uid() + '_' + request.resource.data.blockedId;

      allow update: if false;

      allow delete: if isSignedIn() &&
        (blockId.matches(uid() + '_.*') || isAdmin());
    }

    // ── partyOpenAlerts 컬렉션 (오픈 알림 받기) ─────────────────────
    // 문서 id: "{userId}_{partyId}" — favorites와 같은 패턴이라 신청/취소가
    // 문서 생성/삭제 한 번으로 끝나고, 같은 사람이 같은 파티에 두 번
    // 신청하는 일이 구조적으로 생기지 않는다(중복 발송 방지의 1차 방어선).
    //
    // 실제 발송은 openPartyRecruiting이 partyId로 이 컬렉션을 조회해서
    // notifications 문서를 만든다(Admin SDK라 아래 규칙과 무관하게 읽는다).
    //
    // ⚠️ get/list를 나누는 이유는 favorites 규칙 주석과 완전히 동일하다 —
    //    아직 없는 문서를 구독하는 "알림 받기" 버튼이 resource.data를
    //    참조하는 순간 최초 신청이 전부 PERMISSION_DENIED가 난다.
    match /partyOpenAlerts/{alertId} {
      allow get: if isSignedIn() &&
        (alertId.matches(uid() + '_.*') || isAdmin());

      allow list: if isSignedIn() &&
        (resource.data.userId == uid() || isAdmin());

      allow create: if isActiveMember() &&
        request.resource.data.userId == uid() &&
        alertId == uid() + '_' + request.resource.data.partyId;

      // 수정 개념이 없다 — 신청/취소(생성/삭제)뿐이다.
      allow update: if false;

      allow delete: if isSignedIn() &&
        (alertId.matches(uid() + '_.*') || isAdmin());
    }

    // ── parties/{partyId}/applications 서브컬렉션 (신청 상태 추적) ─────
    // 문서 id: 신청자 uid (파티당 1인 1문서).
    // applyToParty Cloud Function이 신청 시점에 status='applied'로 생성하고,
    // 이후 승인/거절/실제참석/취소/노쇼 전환은 관리자 전용 Functions
    // 콜러블에서만 처리한다 (2단계에서 구현).
    // [읽기] 신청자 본인, 해당 파티 호스트, 관리자
    // [쓰기] 클라이언트 직접 쓰기 전면 차단 — Functions Admin SDK 전용
    //        (verificationSessions 컬렉션과 동일한 보호 패턴)
    //
    // 호스트 판정은 신청서 자신의 hostId를 **먼저** 본다. 결제가 있었던
    // 신청서는 거래기록이라 파티를 삭제해도 남는데(contentCleanup.js),
    // 그때 부모 파티 문서가 없어 get()이 null이 되면 규칙 평가 자체가
    // 실패해 호스트가 자기 거래내역을 못 읽게 된다. ||는 앞이 참이면
    // 뒤를 평가하지 않으므로, hostId가 있는 문서는 get()까지 가지 않는다
    // (get()은 hostId가 없던 옛 신청서용 폴백으로만 남긴다).
    match /parties/{partyId}/applications/{applicationId} {
      allow read: if isSignedIn() && (
        resource.data.uid == uid() ||
        resource.data.get('hostId', '') == uid() ||
        get(/databases/$(database)/documents/parties/$(partyId)).data.hostId == uid() ||
        isAdmin()
      );
      allow write: if false;
    }

    // ── applications 컬렉션 그룹 조회 ────────────────────────────────────
    // 마이페이지 "참가"(개수 뱃지 + 목록)는 collectionGroup('applications')로
    // 내 uid가 걸린 신청서를 파티 전체에서 한 번에 긁어온다
    // (my_page_screen.dart의 _MyJoinedPartyList).
    //
    // **위의 /parties/{partyId}/applications/{applicationId} 규칙은 컬렉션 그룹
    // 쿼리에 적용되지 않는다** — Firestore는 중첩 경로로 명시한 규칙을 컬렉션
    // 그룹 쿼리에 쓰지 않고, 재귀 와일드카드(`/{path=**}/applications/{id}`)로
    // 따로 선언한 규칙만 본다. 이 규칙이 없어서 참가 조회가 통째로
    // permission-denied로 떨어졌고, 개수는 0개로 목록은 무한 로딩으로 보였다.
    //
    // 권한 범위는 위 규칙과 같다(본인 신청서 · 그 파티 호스트 · 관리자).
    // 다만 여기서는 경로에 partyId가 없어 부모 파티를 get()으로 되짚을 수
    // 없으므로, 호스트 판정은 신청서에 저장된 hostId만 쓴다 — hostId가 없던
    // 옛 신청서를 호스트가 읽는 경로는 위의 문서 경로 규칙이 그대로 담당한다
    // (두 규칙은 OR로 평가되므로 이 규칙을 추가해도 기존 접근이 좁아지지 않는다).
    match /{path=**}/applications/{applicationId} {
      allow read: if isSignedIn() && (
        resource.data.uid == uid() ||
        resource.data.get('hostId', '') == uid() ||
        isAdmin()
      );
      allow write: if false;
    }

    // ── reports 컬렉션 (신고) ────────────────────────────────────────
    // 파티/사용자/장소/파티샵/크루 신고 — feedbackRequests(의견 보내기)와는
    // 별개의 전용 컬렉션. 제출 UI는 services/report_service.dart.
    //
    // [읽기] 작성자 본인 또는 관리자
    // [생성] 로그인된 사용자가 자신의 reporterId로만, 초기 상태는 'received'
    // [수정] 관리자만, status/adminMemo/updatedAt/resolvedAt 외 필드 변경 불가
    // [삭제] 관리자만
    //
    // ⚠️ 문서 id를 "{신고자}_{대상종류}_{대상id}"로 **못박는다.** 이것이
    // 중복 신고 방지의 전부다 — 같은 사람이 같은 대상을 두 번 신고하면 같은
    // 문서를 가리키게 되고, update가 막혀 있으므로 두 번째는 거부된다.
    // 카운터도 스케줄러도 필요 없다(favorites와 같은 결정적 id 패턴).
    //
    // ⚠️ **신고가 곧 처벌이 되어서는 안 된다.** 이 규칙은 reports 문서를
    // 만드는 것 외에 어떤 문서도 건드리지 않는다 — 신고로 대상 글이 지워지거나
    // 계정이 정지되는 경로는 존재하지 않는다. 판단과 조치는 관리자만 한다.
    // ── partyReviews 컬렉션 (파티 참여 후기) ─────────────────────────────
    // 실제 참여를 마친 게스트가 남기는 **한 줄** 후기. 별점은 없다.
    //
    // [읽기] 공개 — 파티 상세 하단에 그대로 붙는다.
    // [쓰기] **전면 차단.** 작성·수정·삭제는 전부 Functions 콜러블
    //        (submitPartyReview / deletePartyReview)을 지난다.
    //
    // 왜 클라이언트 쓰기를 한 줄도 열지 않는가:
    //   작성 자격의 정본이 applications/{id}의 checkedInAt인데, 규칙은 그
    //   문서를 get()으로 읽을 수는 있어도 **그 값을 누가 썼는지**까지는 볼 수
    //   없다. 또 작성 기간(그 게스트가 참여한 회차 종료 + 14일)은 정기 파티의
    //   회차 스케줄을 계산해야 나오는 값이라 규칙 언어로 표현할 수 없다.
    //   자격을 규칙으로 반쯤 검사하면 "앱만 고치면 통과"하는 틈이 남으므로,
    //   판정을 전부 서버 한 곳(functions/partyReviews.js)에 둔다.
    //
    // ⚠️ **호스트에게는 어떤 쓰기 권한도 주지 않는다.** 자기 파티에 달린
    //    후기라도 고치거나 지울 수 없다 — 불리한 후기를 치우는 경로가 생기면
    //    후기가 남는다는 사실 자체를 믿을 수 없게 된다.
    //
    // 신고는 기존 UGC 구조를 그대로 쓴다(reports, targetType: 'partyReview').
    // 관리자가 그 신고를 보고 지우는 자리가 아래 delete다.
    //
    // ⚠️ 이 컬렉션은 파티 하위가 아니라 **루트**다. 파티 자동삭제
    //    (deleteExpiredParties → cleanupContentDoc)는 parties 하위의
    //    applications만 건드리므로, 부모 파티가 사라져도 후기는 남는다.
    //    contentCleanup.js에 이 컬렉션을 추가하지 말 것 — 그게 곧 보존 설계다.
    match /partyReviews/{reviewId} {
      allow read: if true;

      // 작성·수정은 Admin SDK 전용(콜러블). 작성자 본인에게도 열지 않는다.
      allow create, update: if false;

      // 관리자 삭제 — 신고 처리 흐름의 종착점. 작성자 본인의 삭제는 기간
      // 검사가 필요해 콜러블(deletePartyReview)이 처리한다.
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isSignedIn() &&
        (resource.data.reporterId == uid() || isAdmin());

      allow create: if isActiveMember() &&
        request.resource.data.reporterId == uid() &&
        request.resource.data.status == 'received' &&
        request.resource.data.targetType is string &&
        request.resource.data.targetId is string &&
        request.resource.data.targetId.size() > 0 &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        // 본인 신고 금지 — 대상이 사용자면 대상 id가, 콘텐츠면 작성자가 나일 수 없다.
        request.resource.data.targetUserId != uid() &&
        !(request.resource.data.targetType == 'user' &&
          request.resource.data.targetId == uid()) &&
        // 중복 신고는 여기서 구조적으로 끝난다.
        reportId == uid() + '_' + request.resource.data.targetType + '_' +
                    request.resource.data.targetId;

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'adminMemo', 'updatedAt', 'resolvedAt'
        ]);

      allow delete: if isAdmin();
    }

    // ── userStats 컬렉션 (사용자별 요약 이용 통계) ──────────────────────
    // 문서 id = uid. 원본 기록(parties/{id}/applications, favorites,
    // analyticsEvents)과 분리된 집계 전용 문서 — Functions만 기록한다.
    // [읽기] 본인 또는 관리자만 (일반 사용자는 자신의 통계만 조회 가능)
    // [쓰기] 클라이언트 직접 불가 — onApplicationStatusWrite/onFavoriteWrite/
    //        onAnalyticsEventCreated/onUserFieldsWrite Functions에서만 갱신
    match /userStats/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isAdmin());
      allow write: if false;
    }

    // ── systemFunctionErrors 컬렉션 (스케줄 함수 실패 기록) ──────────────
    // logScheduledFunctionError(memberActivityHelpers.js)가 Admin SDK로만
    // 기록한다 — 관리자 웹 대시보드/시스템 오류 화면에서 조회용.
    // [읽기] 관리자만 [쓰기] 클라이언트 직접 불가
    match /systemFunctionErrors/{errorId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── analyticsEvents 컬렉션 (행동 로그) ──────────────────────────────
    // 사업적으로 의미 있는 조회/행동 이벤트만 기록하는 불변 로그.
    // CI/DI/휴대폰번호 등 민감정보는 이 컬렉션에 절대 저장하지 않는다.
    // 실시간 위치는 저장하지 않고, 사용자가 실제로 본 파티/장소의 지역만 담는다.
    // [읽기] 본인 또는 관리자만
    // [생성] 로그인된 사용자가 자신의 userId로만, 정의된 이벤트 타입만,
    //        occurredAt은 서버 타임스탬프여야 함(클라이언트가 시각 위조 불가)
    // [수정·삭제] 불가 — 불변 로그
    match /analyticsEvents/{eventId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());

      allow create: if isSignedIn() &&
        request.resource.data.userId == uid() &&
        request.resource.data.occurredAt == request.time &&
        request.resource.data.eventType in [
          'app_open', 'party_view', 'party_search', 'party_favorite_add',
          'party_favorite_remove', 'party_apply', 'party_cancel', 'party_attended',
          'party_create', 'party_share', 'place_view', 'place_reservation'
        ];

      allow update, delete: if false;
    }

    // ── dailyStats / regionStats / hourlyStats (전역 집계) ──────────────
    // 관리자 전용 통계 문서 — 본인확인 정보와 마찬가지로 관리자만 조회 가능.
    // 전부 Functions가 FieldValue.increment()로만 갱신한다.
    match /dailyStats/{dateId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /regionStats/{regionId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /hourlyStats/{hourId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── userActivityLogs (통합 활동 타임라인) ───────────────────────────
    // 회원 상세 페이지의 "통합 활동 타임라인"용 — 가입/로그인/파티·플레이스
    // ·상품·크루 등록/신청·승인·취소/찜/공유/관리자 상태변경 등을 uid와
    // 함께 기록한다. 전부 memberManagement.js의 트리거/onCall이 Admin SDK로만
    // 기록하며, 클라이언트는 본인 것 또는 관리자만 읽을 수 있다.
    match /userActivityLogs/{logId} {
      allow read: if isSignedIn() && (resource.data.uid == uid() || isAdmin());
      allow write: if false;
    }

    // ── reservations 컬렉션 ───────────────────────────────────────────
    // 파라미터 변조 방지 설계:
    //
    //   [읽기] 본인 예약만 조회 가능
    //
    //   [생성] 클라이언트 생성 허용 (장소 예약 기능), 단 아래 조건 강제:
    //   - userId 반드시 자신의 auth.uid와 일치 (타인 위장 방지)
    //   - paymentStatus는 반드시 'pending' (결제 완료 상태 위조 방지)
    //   - reservationStatus는 반드시 'pending'
    //   - totalPrice는 장소의 pricePerHour × durationHours와 일치해야 함
    //     (클라이언트에서 임의 금액 저장 방지)
    //
    //   [수정·삭제] 클라이언트 직접 불가
    //   - paymentStatus 업데이트는 결제 연동 후 Firebase Functions에서만 처리
    //   - 예약 취소는 별도 Functions 엔드포인트에서 처리
    match /reservations/{reservationId} {
      allow read: if isSignedIn() && resource.data.userId == uid();

      allow create: if isVerifiedMember() &&
        // 본인 예약만 생성 가능
        request.resource.data.userId == uid() &&
        // 결제 완료 상태 위조 방지
        request.resource.data.paymentStatus == 'pending' &&
        request.resource.data.reservationStatus == 'pending' &&
        // totalPrice 변조 방지: places 컬렉션의 실제 가격으로 검증
        request.resource.data.totalPrice ==
          get(/databases/$(database)/documents/places/$(request.resource.data.placeId))
            .data.pricePerHour * request.resource.data.durationHours;

      allow update, delete: if false;
    }

    // ── verificationSessions 컬렉션 ──────────────────────────────────
    // 재사용 방지(Replay Prevention) 세션 저장소.
    // 문서 경로: verificationSessions/{uid} (uid당 1개 세션)
    //
    // 쓰기: Functions Admin SDK에서만 (niceIntcRequestUrl, niceIntcResult)
    //       클라이언트 직접 쓰기 차단 → sessionId 위조 불가
    // 읽기: 본인만 자신의 세션 상태(used, expiresAt) 확인 가능
    match /verificationSessions/{userId} {
      allow read: if isSignedIn() && uid() == userId;
      allow write: if false;
    }

    // ── niceAuthSessions 컬렉션 ─────────────────────────────────────────
    // NICE 통합인증 v2(niceAuth.js) 전용 세션 저장소. verificationSessions와
    // 완전히 같은 보호 패턴 — ticket/iterators가 들어 있으므로 클라이언트
    // 쓰기는 전면 차단하고, 읽기도 본인 문서로만 제한한다.
    match /niceAuthSessions/{userId} {
      allow read: if isSignedIn() && uid() == userId;
      allow write: if false;
    }

    // ── identityLinks 컬렉션 ────────────────────────────────────────────
    // "1명의 실사용자 = 파티츄 계정 1개" 정책의 CI ↔ 계정 연결 대장.
    // 문서 경로: identityLinks/{sha256(ci)} (CI 1개당 문서 1개)
    //
    // 클라이언트가 읽을 수 있으면 "이 CI가 이미 가입돼 있는지"를 해시만으로
    // 조회할 수 있게 되고(개인정보 조회 채널), 쓸 수 있으면 남의 CI를 선점하거나
    // 자기 링크를 지워 중복 가입을 뚫을 수 있다. 그래서 읽기·쓰기를 모두 막고
    // Admin SDK(niceAuthResult / niceIntcResult / adminUpdateMember /
    // backfillIdentityLinks)에서만 다룬다.
    match /identityLinks/{ciHash} {
      allow read, write: if false;
    }

    // ── businessOwnership 컬렉션 (사업자번호 점유) ────────────────────
    // 문서 id = sha256(사업자등록번호). 한 사업자번호를 여러 계정이 동시에
    // 'self'로 가져가지 못하게 하는 잠금이다(functions/businessVerification.js).
    //
    // identityLinks와 같은 이유로 읽기·쓰기를 **모두** 막는다.
    //   · 읽을 수 있으면 '이 사업자번호를 누가 잡고 있는가'를 조회하는 채널이
    //     되고, 문서 안의 ownerCiHash까지 함께 새어 나간다.
    //   · 쓸 수 있으면 남의 사업자번호를 미리 선점해 실제 대표자의 자동승인을
    //     막거나(서비스 거부), 자기 점유를 지워 중복 점유를 뚫을 수 있다.
    //
    // 다루는 곳은 Admin SDK(verifyBusinessRegistration) 하나뿐이다.
    match /businessOwnership/{businessNumberHash} {
      allow read, write: if false;
    }

    // ── businessDelegations 컬렉션 (대표자가 부여한 운영권) ───────────
    // 대표자 승인 1건 = 문서 1건. 권한의 근거이자 감사 정본이다
    // (functions/businessDelegation.js).
    //
    // 읽기·쓰기를 **모두** 막는다.
    //   · 쓸 수 있으면 status: 'approved'를 스스로 써넣어 대표자 승인을
    //     통째로 건너뛸 수 있다. users.businessVerification을 잠근 것과
    //     같은 이유이고, 여기가 뚫리면 그 잠금도 함께 무의미해진다.
    //   · 읽을 수 있으면 grantorCiHash(대표자 식별자)와 토큰 해시가 새어
    //     나가고, '어느 계정이 누구에게 위임받았는가'를 훑는 채널이 된다.
    //
    // 신청자가 자기 요청 상태를 보는 길은 getBusinessDelegationStatus
    // 콜러블 하나뿐이다 — 토큰은 그 응답에도 담기지 않는다.
    match /businessDelegations/{delegationId} {
      allow read, write: if false;
    }

    // ── businessApprovalSessions 컬렉션 (대표자 승인용 NICE 세션) ─────
    // niceAuthSessions와 같은 이유로 전면 차단한다 — ticket/iterators가
    // 새면 인증 결과를 복호화할 수 있다.
    //
    // ⚠️ 이 컬렉션은 회원 본인확인 세션과 **일부러 분리**돼 있다. 문서 id가
    //    uid가 아니라 무작위 값이라 계정 없는 대표자도 담을 수 있고,
    //    purpose 필드를 결과 처리기가 단언해 두 흐름이 절대 섞이지 않는다.
    match /businessApprovalSessions/{sessionId} {
      allow read, write: if false;
    }

    // ── hostPreRegistrations 컬렉션 (호스트 사전등록 신청서) ──────────
    // FormHug 신청서 원장 — 업체명·사업자번호·호스트/대표자 연락처가 들어 있다
    // (functions/hostPreRegistration.js).
    //
    //   · 읽기: 관리자만. 신청자 본인에게도 열지 않는다(로그인 계정과 신청서의
    //     연결은 관리자가 확인하기 전까지 근거가 없다).
    //   · 쓰기: 전면 차단. 생성은 웹훅, 상태 전이·계정 연결은 관리자 콜러블
    //     (Admin SDK)만 한다 — 이력(history)과 한 번에 기록하기 위해서다.
    //
    // ⚠️ 이 문서의 status는 **권한의 근거가 아니다.** 사업자 권한은 여전히
    //    users.businessVerification(isBusinessVerified)만 본다.
    match /hostPreRegistrations/{preRegistrationId} {
      allow read: if isAdmin();
      allow write: if false;

      match /history/{historyId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // FormHug 폼 필드 ↔ 신청서 항목 연결 설정. 관리자 콜러블만 쓴다.
    match /hostPreRegistrationConfig/{configId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── places 컬렉션 ─────────────────────────────────────────────────
    // [읽기] 비로그인 사용자도 목록·상세 조회 가능 (공개 컬렉션)
    // [생성] **사업자 인증을 마친** 사용자가 자신의 hostId로만 등록 가능
    // [수정·삭제] 장소 호스트 또는 관리자만 가능
    //
    // ⚠ 사업자 인증(isBusinessVerified)은 **신규 등록에만** 요구한다.
    //   공간대여·숙박은 실제 사업장을 운영하는 사업자만 올리는 것이라
    //   본인확인(isVerifiedMember)만으로는 부족하다. 앱도 같은 조건으로 진입을
    //   막지만(party_app/lib/services/place_create_eligibility.dart) 구버전 앱과
    //   SDK 직접 호출까지 상대하는 마지막 방어선은 여기다.
    //
    //   update·delete는 **일부러 그대로 둔다** — 이미 등록된 플레이스의
    //   조회·수정·관리는 이 정책의 대상이 아니다. 여기까지 막으면 정책 이전에
    //   등록한 개인 소유 플레이스의 호스트가 자기 문서를 손도 못 대게 된다
    //   (레거시 문서는 삭제·이관하지 않는다). 같은 이유로 placeRooms처럼 이미
    //   만든 플레이스에 딸린 문서도 건드리지 않는다.
    //
    // ⚠ 이 문서는 **누구나 읽는다**(손님이 장소 상세를 보려면 열려 있어야
    //   한다). 그래서 여기에는 개인 계좌 같은 비공개 정보를 절대 두지 않는다.
    //
    //   예전에는 장소 등록 폼이 payoutAccount{bank, accountNumber,
    //   accountHolder}를 이 문서에 저장했다 — 호스트의 은행·계좌번호·예금주가
    //   비로그인 사용자에게까지 그대로 공개되고 있었다. 정산계좌는
    //   users/{uid}.settlementInfo(본인·관리자만 read)로 옮겼고, 아래 조건으로
    //   이 문서에 계좌가 **다시 들어오는 것 자체를** 막는다.
    function hasNoPayoutAccount() {
      return !request.resource.data.keys().hasAny(['payoutAccount']);
    }

    match /places/{placeId} {
      allow read: if true;

      allow create: if isVerifiedMember() &&
        isBusinessVerified() &&
        request.resource.data.hostId == uid() &&
        hasNoPayoutAccount();

      allow update: if isSignedIn() &&
        (resource.data.hostId == uid() || isAdmin()) &&
        hasNoPayoutAccount();

      allow delete: if isSignedIn() && (
        resource.data.hostId == uid() || isAdmin()
      );
    }

    // ── placeRooms 컬렉션 ────────────────────────────────────────────
    // [읽기] 비로그인 사용자도 조회 가능 (장소 상세에서 룸 목록 표시)
    // [생성] **부모 places 문서의 주인**만, 자신의 hostId로 등록 가능
    // [수정·삭제] 부모 플레이스의 주인 또는 관리자만 가능
    //
    // ⚠ 예전에는 `hostId == uid()`만 봤다 — 자기 uid를 hostId에 넣고 **남의
    //   placeId**를 적으면 그 사람 플레이스 상세에 내 룸이 붙었고(상세 화면의
    //   룸 쿼리에는 hostId 필터가 없다), 없는 placeId로 orphan 룸도 만들 수
    //   있었다. [ownsPlace]가 부모 문서를 실제로 읽어 둘 다 막는다
    //   (placePromotions가 쓰던 것과 같은 원칙).
    //
    // ⚠ 저장 순서가 이 규칙의 전제다: 등록은 `places` 문서를 **먼저 커밋한 뒤**
    //   룸을 하나씩 add 하고(place_register_screen.dart), 수정은 부모가 이미
    //   있다. 룸을 부모와 한 배치(batch)에 묶으면 배치 커밋 전에는 부모가
    //   보이지 않아 exists()가 false가 되므로, 그렇게 바꾸면 안 된다.
    match /placeRooms/{roomId} {
      allow read: if true;

      allow create: if isVerifiedMember() &&
        request.resource.data.hostId == uid() &&
        ownsPlace(request.resource.data.get('placeId', ''));

      // 소속(placeId)과 소유자(hostId)는 만든 뒤에 바꿀 수 없다 — 남의
      // 플레이스로 옮겨 붙이는 우회를 막는다(placePromotions와 같은 규칙).
      allow update: if isSignedIn() &&
        (ownsPlace(resource.data.get('placeId', '')) || isAdmin()) &&
        request.resource.data.get('placeId', '') ==
          resource.data.get('placeId', '') &&
        request.resource.data.get('hostId', '') ==
          resource.data.get('hostId', '');

      allow delete: if isSignedIn() &&
        (ownsPlace(resource.data.get('placeId', '')) || isAdmin());
    }

    // ── partyServices 컬렉션 ─────────────────────────────────────────
    // [읽기] 비로그인 사용자도 조회 가능 (공개 컬렉션)
    // [생성] 로그인된 사용자가 자신의 hostId로만 등록 가능
    // [수정·삭제] 호스트 또는 관리자만 가능
    match /partyServices/{serviceId} {
      allow read: if true;

      allow create: if isVerifiedMember() &&
        request.resource.data.hostId == uid();

      allow update, delete: if isSignedIn() && (
        resource.data.hostId == uid() || isAdmin()
      );
    }

    // ── crews 컬렉션 ──────────────────────────────────────────────────
    // [읽기] 비로그인 사용자도 조회 가능 (공개 컬렉션)
    // [생성] 로그인된 사용자가 자신의 hostId로만 등록 가능
    // [수정·삭제] 호스트 또는 관리자만 가능
    match /crews/{crewId} {
      allow read: if true;

      allow create: if isVerifiedMember() &&
        request.resource.data.hostId == uid();

      allow update, delete: if isSignedIn() && (
        resource.data.hostId == uid() || isAdmin()
      );
    }

    // ── partyShops 컬렉션 (파티샵) + products 서브컬렉션 ─────────────────
    // [읽기] 비로그인 사용자도 조회 가능 (공개 컬렉션)
    // [생성] 로그인된 사용자가 자신의 hostId로만 등록 가능
    // [수정·삭제] 샵 호스트 또는 관리자만 가능
    match /partyShops/{shopId} {
      allow read: if true;

      allow create: if isVerifiedMember() &&
        request.resource.data.hostId == uid();

      allow update, delete: if isSignedIn() && (
        resource.data.hostId == uid() || isAdmin()
      );

      match /products/{productId} {
        allow read: if true;

        allow create: if isVerifiedMember() &&
          request.resource.data.hostId == uid();

        allow update, delete: if isSignedIn() && (
          resource.data.hostId == uid() || isAdmin()
        );
      }
    }

    // ── orders 컬렉션 (파티샵 상품 주문) ───────────────────────────────
    // ⚠ 예전에는 이 컬렉션의 규칙이 아예 없었다 — 매칭되는 규칙이 없으면
    //   기본 거부이므로 클라이언트의 주문 생성은 항상 실패했고, 그 코드는
    //   결제 검증 없이 status:'paid'를 직접 쓰려 하고 있었다.
    //
    // 이제 결제가 걸린 다른 흐름(placeReservationGroups / packageBookings /
    // placeProductOrders)과 동일하게 **Functions 전용**으로 못박는다. 주문
    // 생성·확정·취소는 전부 Admin SDK를 쓰는 Cloud Functions에서만 일어나고,
    // 결제 금액/상태는 서버가 PortOne에 직접 조회해 검증한다. 클라이언트는
    // 자기 주문(구매자) 또는 자기 샵 주문(판매자)만 읽을 수 있다.
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.sellerId == uid() ||
        isAdmin()
      );

      allow write: if false;
    }

    // ── placeProducts 컬렉션 (플레이스 공통 상품·이용권) ────────────────
    // 술집·바·카페(events)와 공간대여·숙박(places)이 같은 구조를 공유한다.
    // 어느 쪽 플레이스인지는 문서의 placeCollection 필드로 구분한다.
    //
    // [읽기] 공개 — 플레이스 상세의 '상품·이용권' 목록에 쓰인다.
    // [생성] **부모 플레이스의 주인**만, 본인 hostId로. 판매 수량(soldCount)은
    //        반드시 0에서 시작한다.
    // [수정] 부모 플레이스의 주인/관리자. 단 soldCount·hostId·소속은 못 바꾼다 —
    //        판매 수량은 결제 확정 시 Functions만 올리는 값이라, 여기서 손댈 수
    //        있으면 재고를 되돌려 무한히 팔 수 있게 된다.
    // [삭제] 한 개라도 팔린 상품은 삭제할 수 없다 — 이미 발급된 이용권이
    //        가리킬 상품이 사라지면 QR 검증이 불가능해진다. 판매를 멈추려면
    //        manuallyStopped(판매 중지)를 쓴다.
    //
    // ⚠ placeRooms와 같은 이유로 [ownsSourcePlace]를 건다 — hostId만 보면 남의
    //   플레이스에 내 상품을 붙일 수 있고(상세의 상품 쿼리도 placeId로만
    //   조회한다), 없는 placeId로 orphan 상품도 만들 수 있었다. 룸과 달리
    //   부모가 events일 수도 있어 두 인자짜리 헬퍼를 그대로 쓴다.
    //
    // ⚠ `placeCollection`이 없는 옛 문서는 'events'로 본다 — PlaceProduct
    //   모델의 기본값과 같다(place_product.dart의 fromMap).
    //
    // ⚠ 저장 순서 전제도 룸과 같다: 플레이스 문서가 커밋된 **뒤에** 상품을
    //   쓴다(PlaceProductService.syncForPlace는 개별 set/update만 쓰고,
    //   배치는 순서 변경(reorder)에만 쓴다 — 그때 부모는 이미 있다).
    match /placeProducts/{productId} {
      allow read: if true;

      allow create: if isVerifiedMember() &&
        request.resource.data.hostId == uid() &&
        request.resource.data.soldCount == 0 &&
        ownsSourcePlace(
          request.resource.data.get('placeCollection', 'events'),
          request.resource.data.get('placeId', '')
        );

      allow update: if isSignedIn() &&
        (ownsSourcePlace(
          resource.data.get('placeCollection', 'events'),
          resource.data.get('placeId', '')
        ) || isAdmin()) &&
        request.resource.data.soldCount == resource.data.soldCount &&
        request.resource.data.hostId == resource.data.hostId &&
        request.resource.data.get('placeId', '') ==
          resource.data.get('placeId', '') &&
        request.resource.data.get('placeCollection', 'events') ==
          resource.data.get('placeCollection', 'events');

      allow delete: if isSignedIn() &&
        (ownsSourcePlace(
          resource.data.get('placeCollection', 'events'),
          resource.data.get('placeId', '')
        ) || isAdmin()) &&
        resource.data.soldCount == 0;
    }

    // ── checkInTokens 컬렉션 (통합 QR 체크인 토큰) ────────────────────────
    // QR에 담기는 난수 토큰 하나가 곧 이 컬렉션의 **문서 id**다. 문서에는
    // 어떤 개인정보도 없고(도메인·원본경로·hostId·guestUid뿐), 그마저도
    // 클라이언트가 읽을 이유가 없다.
    //
    // [읽기] 전면 차단 — 토큰을 주운 사람이 원본 경로를 알아내면 그 문서를
    //        직접 조회해 볼 여지가 생긴다. 조회는 resolveCheckInToken이
    //        호스트 본인인지 확인한 뒤에만 대신 해 준다.
    // [쓰기] 전면 차단 — 발급·소진·되돌리기는 전부 Admin SDK 전용
    //        (checkInTokens.js). 클라이언트가 토큰을 만들 수 있으면 아무 QR이나
    //        유효하게 만들 수 있다.
    match /checkInTokens/{token} {
      allow read, write: if false;
    }

    // 감사 기록(누가 언제 체크인/되돌리기를 했나)도 서버 전용이다.
    match /checkInTokens/{token}/events/{eventId} {
      allow read, write: if false;
    }

    // ── checkInTokenIndex 컬렉션 (원본 1건 → 살아 있는 토큰 포인터) ────────
    // 문서 id = sha256(원본 문서 경로). "이 예약의 지금 유효한 QR은 무엇인가"를
    // 트랜잭션 한 번으로 답하기 위한 색인이자, 발급이 몇 번 재실행돼도 토큰이
    // 하나만 살아 있게 붙드는 잠금 지점이다(checkInTokenStore.js).
    //
    // 전면 차단 — 이 문서에는 **토큰 원문**이 들어 있다. 읽을 수 있으면 남의
    // 예약 경로만 알아도 그 QR을 그대로 얻는다. 게스트는 자기 QR을 자기 신청·
    // 예약 문서의 checkInToken 필드로만 받는다(그 문서는 본인·호스트·관리자만
    // 읽을 수 있고, 클라이언트 쓰기는 이미 막혀 있다).
    match /checkInTokenIndex/{key} {
      allow read, write: if false;
    }

    // ── placeProductOrders 컬렉션 (상품 주문 = QR 이용권) ───────────────
    // 결제·사용 처리 전 구간이 Functions 전용이다(placeBookings와 같은 정책).
    // 클라이언트가 직접 쓸 수 있으면 '사용 가능' 상태나 결제 금액을 위조해
    // 이용권을 무한히 만들거나 되살릴 수 있다.
    //
    // [읽기] 구매자 본인, 해당 상품의 판매자(호스트), 관리자.
    //        사장님이 QR을 스캔해 주문을 확인하는 경로도 이 읽기 권한을 쓴다.
    // [쓰기] 전면 차단 — createPendingProductOrder / verifyAndConfirmProductOrder
    //        / cancelProductOrder / redeemProductVoucher / expireStaleProductOrders
    match /placeProductOrders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.hostId == uid() ||
        isAdmin()
      );

      allow write: if false;
    }

    // ── placeMenus 컬렉션 (매장 메뉴) ────────────────────────────────────
    // "하이볼 8,000원"처럼 매장에서 시켜 먹는 것만 담는다. 앱에서 결제하는
    // 이용권은 placeProducts이고, 여기에는 재고·주문·QR이 아예 없다.
    //
    // 결제가 걸리지 않으므로 placePromotions와 **완전히 같은 정책**을 쓴다.
    //
    // [읽기] 공개 — 플레이스 상세에서 손님에게 보여준다.
    // [생성] 본인 hostId로만.
    // [수정·삭제] 호스트 또는 관리자. hostId는 바꿀 수 없다(남의 플레이스
    //             메뉴로 옮겨 붙이는 걸 막는다).
    match /placeMenus/{menuId} {
      allow read: if true;

      allow create: if isVerifiedMember() &&
        request.resource.data.hostId == uid();

      allow update: if isSignedIn() &&
        (resource.data.hostId == uid() || isAdmin()) &&
        request.resource.data.hostId == resource.data.hostId;

      allow delete: if isSignedIn() &&
        (resource.data.hostId == uid() || isAdmin());
    }

    // ── placePromotions 컬렉션 (매장 이벤트·프로모션) ────────────────────
    // "오늘 혼술 환영", "직장인 할인"처럼 **결제가 없는 홍보**만 담는다.
    // 결제가 걸리는 내용은 placeProducts로 등록하고, 프로모션에서는
    // linkedProductIds로 연결만 한다.
    //
    // 재고·주문·이용권이 없어 서버 함수를 거칠 이유가 없으므로, 다른 공개
    // 등록물(events·placeRooms·partyServices)과 같은 단순 정책을 쓴다.
    //
    // [읽기] 공개 — 플레이스 상세에서 보여준다.
    // [생성] 본인 hostId로만.
    // [수정·삭제] 호스트 또는 관리자. hostId는 바꿀 수 없다(남의 플레이스
    //             프로모션으로 옮겨 붙이는 걸 막는다).
    // ⚠ hostId만 보면 부족하다 — 자기 uid를 hostId에 넣고 **남의 placeId**를
    //   가리키는 문서를 만들 수 있고, 손님 화면은 placeId로만 조회하므로 그
    //   이벤트가 남의 플레이스 상세에 그대로 노출된다. 그래서 원본 장소
    //   문서(events/places)를 실제로 읽어 그 hostId가 나인지까지 확인한다.
    //   판정 자체는 위 헬퍼 [ownsSourcePlace]에 있다(placeRooms·placeProducts와
    //   같은 것을 쓴다).

    match /placePromotions/{promotionId} {
      allow read: if true;

      // [생성] 본인 hostId + **원본 장소의 주인도 나**일 때만.
      allow create: if isVerifiedMember() &&
        request.resource.data.hostId == uid() &&
        ownsSourcePlace(
          request.resource.data.placeCollection,
          request.resource.data.placeId
        );

      // [수정] 소속(hostId/placeId/placeCollection)은 못 바꾼다 — 만든 뒤에
      //        남의 장소로 옮겨 붙이는 우회를 막는다. 관리자는 소속을 그대로
      //        둔 채 내용만 손볼 수 있다(신고 대응).
      allow update: if isSignedIn() &&
        (resource.data.hostId == uid() || isAdmin()) &&
        request.resource.data.hostId == resource.data.hostId &&
        request.resource.data.placeId == resource.data.placeId &&
        request.resource.data.placeCollection == resource.data.placeCollection;

      allow delete: if isSignedIn() &&
        (resource.data.hostId == uid() || isAdmin());
    }

    // ── placeEventApplications 컬렉션 (매장 이벤트 신청) ──────────────────
    // 손님이 매장 이벤트에 **실제로 신청한 기록**. 문의(채팅)와는 완전히
    // 별개다 — 문의는 chatRooms에 남고, 신청은 여기 남는다.
    //
    // 문서 id: `{eventId}_{guestId}` (이벤트당 1인 1문서).
    //
    // [읽기] 신청한 본인, 그 이벤트의 호스트, 관리자
    // [쓰기] 클라이언트 직접 쓰기 **전면 차단** — Functions Admin SDK 전용
    //        (parties/{partyId}/applications와 같은 보호 패턴)
    //
    // ── 왜 클라이언트 쓰기를 접었나 ─────────────────────────────────────
    // 처음에는 여기서 create/update를 열고 위조만 막았다(guestId == uid,
    // hostId·placeId는 원본 이벤트와 대조). 그런데 **종료된 이벤트를 막을 수
    // 없었다.** 종료 판정은 `isAlways`·`endAt`을 "그 날 23:59:59"로 접는
    // 계산이고(PlacePromotion.statusAt), 그것을 rules로 옮겨 적으면 하루의
    // 경계에서 앱과 어긋난다 — 어긋나는 쪽은 "앱에는 버튼이 있는데 서버가
    // 거부"다. 그렇다고 두면 변조된 클라이언트가 종료된 이벤트에 그대로
    // 신청을 넣는다("버튼이 안 보인다"는 방어가 아니다).
    //
    // 그래서 판정을 서버 한 곳에 모았다. 신청·취소는 콜러블만 한다
    // (functions/placeEventApplications.js — applyToPlaceEvent /
    //  cancelPlaceEventApplication). 서버는 이벤트 원본을 직접 읽어
    //   · 이벤트 존재      · 노출(isVisible)      · applyMode
    //   · 종료 여부(KST)   · 본인 이벤트가 아님    · 본인확인(identityGuard)
    // 을 확인한 뒤에만 쓴다. hostId·placeId·eventTitle·장소명·일정도 전부
    // **서버가 원본에서 베낀 값**이라 클라이언트가 위조할 입력 자체가 없다.
    //
    // ⚠ 컬렉션 이름이 `applications`가 **아니다. 그래야만 한다.**
    //   위쪽 `/{path=**}/applications/{applicationId}` 재귀 규칙과 서버의
    //   `collectionGroup('applications')` 집계(탈퇴 차단 accountWithdrawal.js,
    //   매출 통계 adminSalesStats.js)가 파티 신청을 세는 코드다. 이름을
    //   공유하면 매장 이벤트 신청이 파티 신청으로 세어져 탈퇴가 막히고 매출
    //   통계에 빈 건이 섞인다.
    //
    // ⚠ 삭제도 클라이언트에게 열지 않는다. 취소는 상태 전환이지 삭제가
    //   아니고(지우면 "신청했다가 취소했다"가 사라진다), 이벤트가 지워질 때의
    //   정리는 서버 트리거가 한다(onPlacePromotionDeleted).
    match /placeEventApplications/{applicationId} {
      // 호스트의 목록 쿼리는 반드시 `where('hostId', '==', 내 uid)`를 달아야
      // 한다 — 규칙이 그 조건으로만 통과시키므로, 빼면 목록 전체가
      // permission-denied가 된다(앱의 watchAppliedCountsForPlace 참고).
      // 손님 화면에 신청자 수를 공개하지 않는 이유도 이것이다: 남의 신청
      // 문서를 읽을 수 있는 사람은 없다.
      allow read: if isSignedIn() && (
        resource.data.get('guestId', '') == uid() ||
        resource.data.get('hostId', '') == uid() ||
        isAdmin()
      );

      allow write: if false;
    }

    // ── events 컬렉션 (플레이스 본체 — 매장·즐길거리) ──────────────────
    // ⚠ 이름이 헷갈린다: 이 컬렉션은 **플레이스 본체**다(파티츄의 "이벤트"
    //   한 건은 placePromotions에 있다 — party_event_source.dart 상단 주석).
    //   그래서 여기 create는 곧 **신규 플레이스 등록**이고, places와 같은
    //   조건을 쓴다.
    //
    // [읽기] 비로그인 사용자도 조회 가능 (공개 컬렉션)
    // [생성] **사업자 인증을 마친** 사용자가 자신의 hostId로만 등록 가능
    // [수정·삭제] 호스트 또는 관리자만 가능 — 신규 등록만 막고 기존 문서의
    //   조회·수정·관리는 그대로 둔다(places 규칙과 같은 이유).
    match /events/{eventId} {
      allow read: if true;

      allow create: if isVerifiedMember() &&
        isBusinessVerified() &&
        request.resource.data.hostId == uid();

      allow update, delete: if isSignedIn() && (
        resource.data.hostId == uid() || isAdmin()
      );
    }

    // ── feedbackRequests 컬렉션 (고객센터 문의) ────────────────────────
    // 파티/사용자 신고, 환불 요청, 결제 분쟁, 긴급 문의와는 완전히 분리된
    // 전용 컬렉션 — 개선 제안·버그 신고·고객센터 문의가 유형(type)으로만
    // 갈려 한 컬렉션에 쌓인다.
    //
    // ⚠️ 이 문서에는 **작성자가 직접 적은 답변용 연락처**(contactEmail ·
    //    contactPhone)가 들어 있다. 그래서 목록 읽기가 열리면 안 된다 —
    //    아래 read가 '본인 또는 관리자'인 것이 그 연락처와 문의 내용을
    //    지키는 유일한 장치다(닉네임·실명·계정 이메일은 애초에 저장하지
    //    않는다. 관리자 화면이 userId로 users 문서를 따로 붙인다).
    //
    // [읽기] 본인이 작성한 문의 또는 관리자만 조회 가능
    // [생성] 로그인된 사용자가 자신의 userId로만 생성, 초기 상태는 반드시
    //        status='received', userReply/adminMemo는 빈 문자열이어야 함
    //        (접수 전부터 답변이 달린 것처럼 위조하는 것 방지)
    // [수정] 일반 사용자는 절대 불가(본인 것이라도 수정 불가) — 관리자만 가능,
    //        관리자도 status/userReply/adminMemo/updatedAt 외 필드는 변경 불가
    //        (작성자·원문 내용·연락처 위변조 방지)
    // [삭제] 관리자만 가능

    /// 답변받을 연락처가 규격을 지키는가.
    ///
    /// ⚠️ **필수는 신규 유형에만 건다.** 이 규칙은 앱보다 먼저 배포되는데,
    ///    이미 스토어에 나가 있는 구버전 앱은 contactEmail을 아예 보내지
    ///    않는다. 전 유형에 필수를 걸면 그 순간 구버전 앱의 의견 보내기가
    ///    통째로 막힌다. 반대로 'payment'·'host'는 구버전 앱의 선택지에
    ///    없어서 **새 앱만 만들 수 있는 값**이므로, 거기에만 필수를 걸면
    ///    하위호환을 깨지 않고도 새 흐름은 실제로 강제된다.
    ///
    ///    나머지 유형에서 "비어 있으면 안 된다"를 집행하는 곳은 앱
    ///    (FeedbackContact·FeedbackService.submit)이다. 서버 강제가 필요해지면
    ///    콜러블 생성 경로를 먼저 만들어야 한다 — 지금 이 컬렉션은 클라이언트가
    ///    직접 쓴다.
    function feedbackContactOk() {
      return request.resource.data.get('contactEmail', '') is string &&
        request.resource.data.get('contactPhone', '') is string &&
        (!(request.resource.data.type in ['payment', 'host']) ||
          request.resource.data.get('contactEmail', '').size() > 0);
    }

    match /feedbackRequests/{feedbackId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == uid() || isAdmin());

      allow create: if isActiveMember() &&
        request.resource.data.userId == uid() &&
        request.resource.data.status == 'received' &&
        request.resource.data.userReply == '' &&
        request.resource.data.adminMemo == '' &&
        request.resource.data.title is string &&
        request.resource.data.content is string &&
        // ⚠️ 값은 party_app의 FeedbackType과 글자 그대로 같아야 한다.
        //    'improvement'는 새 화면의 선택지에 없지만 옛 문서가 쓰던 값이라
        //    남겨 둔다(빼면 그 유형의 재접수만 막히고 얻는 것이 없다).
        //
        //    'payment'(결제/환불)도 **여기서는 계속 받는다.** 새 앱은 이 값을
        //    보내지 않지만(FeedbackType.retired — 결제·환불은 호스트가 직접
        //    처리한다), 스토어에 나가 있는 구버전 앱은 아직 선택지로 들고
        //    있다. 지금 빼면 그 사용자들의 문의만 permission-denied로 조용히
        //    막힌다 — 구버전이 충분히 빠진 뒤에 빼는 값이다.
        request.resource.data.type in
          ['improvement', 'bug', 'inquiry', 'payment', 'host', 'other'] &&
        feedbackContactOk();

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'userReply', 'adminMemo', 'updatedAt'
        ]);

      allow delete: if isAdmin();
    }

    // ── appConfig 컬렉션 ──────────────────────────────────────────────
    // 앱 업데이트 정책(appConfig/version 등) 저장소.
    // [읽기] 로그인 여부와 무관하게 앱 실행 즉시(로그인 전에도) 버전을 확인해야
    //        하므로 전체 공개 읽기 허용 — 민감정보 없음(버전/스토어 URL뿐).
    // [쓰기] 관리자만 — 코드 배포 없이 값만 바꿔 정책을 바꾸는 용도이므로
    //        일반 사용자가 조작할 수 없어야 한다.
    // ── nicknames 컬렉션 (닉네임 예약) ─────────────────────────────────
    // 문서 id = 정규화된 닉네임(trim + NFC + 소문자), 값 = { uid, nickname }.
    //
    // 이 문서의 **생성 자체가 잠금**이다 — 두 사람이 동시에 같은 이름을 저장해도
    // 트랜잭션에서 한쪽만 만들 수 있다. 그래서 클라이언트가 이 컬렉션을 쓸 수
    // 있으면 안 된다(남의 예약을 지우거나, 쓰지도 않을 이름을 선점해 버릴 수
    // 있다). 오직 Admin SDK(setNickname 콜러블·탈퇴 처리)만 기록한다.
    //
    // [읽기] 금지 — "이 닉네임을 누가 쓰는가"는 uid 역조회 통로가 된다.
    //        사용 가능 여부는 checkNicknameAvailable 콜러블이 답한다.
    // [쓰기] 금지 — 서버 전용.
    match /nicknames/{normalizedNickname} {
      allow read, write: if false;
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── places/{placeId}/reservationSlots 서브컬렉션 (장소대여 예약 — 공개) ──
    // 개인정보를 절대 담지 않는 "예약 가능 여부 확인용" 문서다 — 필드는
    // roomId/groupId/startAt/endAt/status/expiresAt 뿐(placeReservations.js
    // createPendingReservation 참고). 예약자 이름·연락처·인원·가격 등은 전부
    // placeReservationGroups(비공개)에만 있다.
    // [읽기] 개인정보가 없으므로 누구나 조회 가능(비로그인 이용자도 장소
    //        상세를 볼 수 있는 것과 동일한 공개 수준 — places 컬렉션 규칙 참고).
    // [쓰기] createPendingReservation/verifyAndConfirmReservation/
    //        cancelReservation/expireStalePlaceReservations Admin SDK 전용.
    match /places/{placeId}/reservationSlots/{slotId} {
      allow read: if true;
      allow write: if false;
    }

    // ── placeReservationGroups 컬렉션 (장소대여 예약 1건 단위 — 비공개) ─────
    // 시간제(여러 슬롯)/패키지/하루단위 예약 1건을 대표하는 그룹 문서 —
    // 포트원 paymentId로 그대로 쓰인다. 예약자 이름·연락처·인원·결제금액 등
    // 개인정보/영업정보를 전부 담고 있으므로 본인·해당 장소 호스트·관리자만
    // 읽을 수 있다.
    // [읽기] 예약자 본인(requesterId), 해당 장소 호스트(hostId), 관리자만.
    // [쓰기] 클라이언트 직접 불가 — placeReservations.js Admin SDK 전용
    //        (결제 검증 없이 확정 상태를 위조할 수 없도록 전면 차단).
    match /placeReservationGroups/{groupId} {
      allow read: if isSignedIn() &&
        (resource.data.requesterId == uid() ||
         resource.data.hostId == uid() ||
         isAdmin());
      allow write: if false;
    }

    // ── events/{placeId}/visitSlots 서브컬렉션 (플레이스 방문 예약 — 공개) ───
    // 무료 방문 예약이 시간대별로 **몇 명 잡혔는지**만 담은 문서다 — 필드는
    // date/startAt/endAt/capacity/reservedPeople 뿐(placeVisitReservations.js
    // 참고). 예약자 이름·연락처·요청사항은 전부 placeVisitReservations
    // (비공개)에만 있다.
    // [읽기] 개인정보가 없고, 예약 화면이 "이 시간 자리 있나"를 보여주려면
    //        필요하다 — 장소대여의 reservationSlots와 같은 공개 수준.
    // [쓰기] createVisitReservation/decideVisitReservation/
    //        cancelVisitReservation/expireStaleVisitReservations Admin SDK 전용.
    match /events/{placeId}/visitSlots/{slotId} {
      allow read: if true;
      allow write: if false;
    }

    // ── placeVisitReservations 컬렉션 (플레이스 방문 예약 1건 — 비공개) ──────
    // 결제가 없는 "방문 요청" 1건 — 유료 좌석 상품(placeProductOrders)이나
    // 장소대여 공간 예약(placeReservationGroups)과는 별개 기능이다. 예약자
    // 이름·연락처·요청사항을 담고 있으므로 본인·해당 매장 업주·관리자만 읽는다.
    // [읽기] 예약자 본인(requesterId), 매장 업주(hostId), 관리자만.
    // [쓰기] 클라이언트 직접 불가 — placeVisitReservations.js Admin SDK 전용
    //        (승인 상태나 정원을 클라이언트가 위조할 수 없도록 전면 차단).
    match /placeVisitReservations/{reservationId} {
      allow read: if isSignedIn() &&
        (resource.data.requesterId == uid() ||
         resource.data.hostId == uid() ||
         isAdmin());
      allow write: if false;
    }

    // ── packageBookings 컬렉션 (숙박+파티 패키지 예약 1건 단위 — 비공개) ────
    // placeReservationGroups와 동일한 보호 패턴 — 방 예약 + 파티 신청을
    // 하나로 묶은 패키지 예약 문서. 예약자 이름·연락처·인원·결제금액 등
    // 개인정보/영업정보를 전부 담고 있으므로 본인·해당 장소 호스트·관리자만
    // 읽을 수 있다.
    // [읽기] 예약자 본인(requesterId), 해당 장소 호스트(hostId), 관리자만.
    // [쓰기] 클라이언트 직접 불가 — packageBookings.js Admin SDK 전용
    //        (결제 검증 없이 확정 상태를 위조할 수 없도록 전면 차단).
    match /packageBookings/{bookingId} {
      allow read: if isSignedIn() &&
        (resource.data.requesterId == uid() ||
         resource.data.hostId == uid() ||
         isAdmin());
      allow write: if false;
    }

    // ── placeBookings 컬렉션 ──────────────────────────────────────────
    // [읽기] 로그인된 사용자라면 예약 슬롯 현황 조회 가능
    //        (placeId 기준 쿼리로 예약된 시간대 확인)
    //        개인정보(requesterName 등)는 추후 Functions 엔드포인트로 분리 예정
    // [생성] 본인 예약만 생성 가능, 초기 상태 위조 방지
    // [수정·삭제] 클라이언트 직접 불가 (취소·상태 변경은 Functions에서 처리)
    match /placeBookings/{bookingId} {
      allow read: if isSignedIn();

      allow create: if isVerifiedMember() &&
        request.resource.data.userId == uid() &&
        request.resource.data.paymentStatus == 'pending' &&
        request.resource.data.bookingStatus == 'pending';

      allow update, delete: if false;
    }

    // ── drafts 컬렉션 (등록 화면 임시저장 — 비공개) ────────────────────────
    // 문서 id = "{userId}__{type}" (사용자별·등록유형별 1개 고정). 본인만
    // 조회·생성·수정·삭제할 수 있는 완전 비공개 컬렉션 — 목록/검색에 절대
    // 노출되지 않는다.
    //
    // get/delete는 아직 존재하지 않는 문서를 get()으로 확인할 때 resource가
    // null이 되어 규칙 평가가 실패하는 것을 피하기 위해, 소유권을
    // resource.data가 아니라 문서 id 접두어로 판정한다(등록 화면이 "임시저장이
    // 있나?"를 물을 때 늘 지나는 경로다).
    //
    // ⚠ 그런데 read 하나로 묶어두면 **목록 쿼리(list)가 통째로 거부된다** —
    // 쿼리는 대상 문서가 하나로 정해져 있지 않아 규칙 엔진이 {draftId}를
    // 특정 값에 묶을 수 없기 때문이다. 마이페이지 "임시저장" 목록
    // (drafts where userId == 나, DraftService.watchAllDrafts)이 정확히 그
    // 경로라 항상 PERMISSION_DENIED로 죽고 있었다.
    //
    // favorites가 같은 문제를 먼저 겪고 get/list를 나눈 것과 **동일한 처리**다:
    // 단건은 문서 id로, 목록은 resource.data.userId로 소유권을 본다. list는
    // 남의 문서를 결과에 담는 순간 거부되므로 권한이 넓어지지 않는다.
    match /drafts/{draftId} {
      allow get, delete: if isSignedIn() && draftId.matches(uid() + '__.*');

      allow list: if isSignedIn() && resource.data.userId == uid();

      // 탈퇴 대기 중에는 임시저장도 새로 쓰지 못한다 — 임시저장은 새 등록의
      // 준비 단계라 여기만 열어두면 "등록은 막혔는데 초안은 계속 쌓이는" 상태가
      // 된다. 읽기·삭제는 그대로 열려 있어 남은 초안을 확인하고 지울 수 있다.
      allow create, update: if isActiveMember() &&
        request.resource.data.userId == uid() &&
        draftId == uid() + '__' + request.resource.data.type;
    }

    // 알림 — 서버(Cloud Functions)만 쓰고, 본인 것만 읽는다.
    // 지금은 최소 모집 인원 미달 자동 취소 안내가 여기 쌓인다.
    // 읽음 표시(read)만 본인이 바꿀 수 있고 내용은 못 고친다.
    match /notifications/{notificationId} {
      allow read, delete: if isSignedIn() && resource.data.uid == uid();

      allow update: if isSignedIn() &&
        resource.data.uid == uid() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read']);

      // 생성은 서버 전용(Admin SDK는 규칙을 우회한다).
      allow create: if false;
    }

    // ── adminNotifications (관리자 업무 알림) ───────────────────────────────
    // 운영자가 처리해야 할 일이 생겼을 때 서버가 남기는 알림. 지금은 호스트
    // 사전등록 신청 접수가 쌓인다(functions/adminNotifications.js).
    //
    // ⚠️ 위의 `notifications`와 **일부러 분리했다.** 거기에 관리자 uid로 쓰면
    //    ① onNotificationCreated 트리거가 관리자 개인 폰으로 FCM을 쏘고
    //    ② 관리자가 사용자 앱을 켰을 때 홈 종에 운영 전용 내용이 섞여 보인다.
    //
    // 읽음은 `readBy` 배열에 자기 uid를 넣는 것으로 표시한다 — 관리자가 여럿일
    // 때 한 사람이 읽어도 다른 사람의 안 읽음이 그대로 남아야 하기 때문이다.
    match /adminNotifications/{notificationId} {
      // 관리자만 읽는다. 일반 사용자는 문서의 존재조차 알 수 없다.
      allow read: if isAdmin();

      // 본문은 서버(Admin SDK)만 만든다. 지우지도 못한다 — 처리해야 할 일이
      // 알림째 사라지면 무엇을 놓쳤는지 알 방법이 없다.
      allow create, delete: if false;

      // 읽음 표시만. 세 줄이 각각 다른 것을 막는다.
      //   1) readBy 말고 다른 칸(title·body·refId…)은 건드릴 수 없다.
      //   2) 이미 들어 있던 uid를 뺄 수 없다 — 남의 읽음을 되돌리지 못한다.
      //   3) 새로 넣을 수 있는 값은 자기 uid 하나뿐이다 — 남을 대신해
      //      읽음 처리할 수 없다.
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readBy']) &&
        resource.data.readBy.hasOnly(request.resource.data.readBy) &&
        request.resource.data.readBy
          .hasOnly(resource.data.readBy.concat([uid()]));
    }

    // ── chatRooms (1:1 문의 채팅) ───────────────────────────────────────────
    // 파티샵·플레이스·파티크루 글의 "채팅하기"로 열리는 방. 참가자는 항상 두
    // 명(hostId, guestId)이고 participants 배열에 그 둘이 들어간다.
    //
    // 이 컬렉션에는 지금까지 규칙이 **아예 없었다** → 기본 거부라 채팅 기능
    // 전체(목록·방 열기·메시지 전송)가 PERMISSION_DENIED로 죽어 있었다.
    // 채팅 목록 화면이 그 실패를 "아직 채팅이 없습니다"로 보여주고 있어서
    // 겉으로는 그냥 대화가 없는 것처럼 보였다.
    //
    // 소유권은 participants 배열 하나로만 판정한다 — 방 문서를 읽을 수 있는
    // 사람 = 그 방의 참가자.
    //
    // ⚠️ **관리자에게도 여기를 열지 않는다.** 관리자 웹의 "채팅 관리" 화면은
    // isAdmin() 예외가 아니라 Admin SDK onCall
    // (functions/adminChatViewer.js의 adminListChatRooms/adminGetChatRoom)만
    // 거친다. `allow read: if isAdmin()`을 한 줄 추가하는 순간 admin claim을 가진
    // **아무 클라이언트나** collectionGroup/list로 전체 개인 대화를 긁을 수 있고,
    // 규칙에는 "누가 언제 무엇을 읽었는지" 남길 자리가 없다. 그 두 가지를 다
    // 지키려고 통로를 서버 함수 하나로 좁혀 두었다(열람 시 userActivityLogs에
    // actorType:'admin'으로 감사 로그가 남는다).
    match /chatRooms/{roomId} {
      // ⚠️ get과 list를 **반드시 나눈다**(favorites 규칙과 완전히 같은 이유).
      //
      // · get — 아직 없는 문서를 읽는 일이 정상 흐름에 있다. 채팅방을 열 때
      //   ChatService가 결정적 id("{내uid}_{종류}_{대상id}")로 방이 있는지
      //   먼저 확인하는데, 문서가 없으면 resource가 null이라
      //   `resource.data.participants`를 보는 조건은 평가 자체가 실패해
      //   PERMISSION_DENIED가 난다 — 즉 **첫 대화는 영영 열리지 않는다.**
      //   그래서 문서 id로 먼저 판단하고(내 uid로 시작하는 방 = 내가 게스트로
      //   만든 방), 그게 아니면 예전 임의 id 방을 위해 참가자 여부를 본다.
      //   ||는 앞이 참이면 뒤를 평가하지 않으므로 순서가 중요하다.
      //
      // · list — 반대로 문서 id로 판별할 수 없다(쿼리에 id 제약이 없다).
      //   목록 쿼리는 participants array-contains로 제한돼 있어야만 통과한다 —
      //   필터 없는 전체 조회는 여기서 걸러진다. list는 실제 결과 문서에
      //   대해 평가되므로 resource가 null일 수 없다.
      allow get: if isSignedIn() &&
        (roomId.matches(uid() + '_.*') || uid() in resource.data.participants);

      allow list: if isSignedIn() && uid() in resource.data.participants;

      // ── 방 만들기는 서버만 한다 ────────────────────────────────────────
      //
      // 새 채팅방을 열어도 되는지는 두 가지 중 하나로 갈린다.
      //
      //   · 이미 신청·예약·주문한 사이인가
      //   · 아니면 호스트가 문의를 열어 뒀는가(inquiryEnabled)
      //
      // 앞쪽을 규칙으로는 확인할 수 없다. 예약 기록은
      // placeVisitReservations·placeReservationGroups·packageBookings·
      // placeProductOrders·orders처럼 **임의 id 문서를 쿼리해야** 찾을 수 있는데,
      // 보안 규칙은 쿼리를 할 수 없다(exists/get으로 경로 하나만 본다).
      //
      // 예전에는 방 문서에 적힌 origin('inquiry'/'booking')을 보고 문의만
      // 걸렀다. 그런데 그 값을 쓰는 쪽이 클라이언트라, origin을 'booking'이라
      // 적어 보내면 문의 OFF가 통째로 무력해졌다 — 판정이 아니라 신고였다.
      //
      // 그래서 생성을 콜러블 하나로 좁혔다(functions/chatRooms.js의
      // createChatRoom). 서버는 원본 글에서 호스트와 inquiryEnabled를 직접 읽고,
      // 예약 기록도 직접 찾은 뒤에만 Admin SDK로 방을 만든다.
      //
      // ⚠️ 배포 순서: 이 줄을 올리는 순간 **콜러블을 모르는 구버전 앱은 새
      // 대화를 시작하지 못한다.** 새 앱 배포와 appConfig/version.minVersion
      // 상향(강제 업데이트)이 먼저 나간 뒤에 이 규칙을 올려야 한다.
      // 이미 만들어진 방은 이 규칙과 무관하다 — 읽기·목록·메시지·미리보기
      // 갱신은 아래 규칙 그대로라서, 문의를 닫아도 기존 대화는 계속된다.
      allow create: if false;

      // 메시지를 보낼 때 목록 미리보기만 갱신한다(ChatService.sendMessage 배치).
      // participants·hostId 같은 소속 필드는 못 건드린다 — 만든 뒤에 남을
      // 방에 자신을 끼워 넣는 우회를 막는다.
      //
      // ── 안 읽음 표시 두 필드 ───────────────────────────────────────────
      // chatRooms에는 읽음 상태가 원래 없었다. 하단 채팅 탭 배지를 위해 방
      // 문서에 두 개를 얹는다(메시지를 전수 조회하지 않으려는 선택이다 —
      // 판정에 필요한 값이 전부 방 문서에 있으면 목록 쿼리 하나로 끝난다).
      //
      //   · lastSenderId          — 마지막으로 말한 사람
      //   · lastReadAt: {uid: ts} — 참가자별 읽음 시각
      //
      // 둘 다 **위조되면 안 되는 값**이라 여기서 두 가지를 못 박는다.
      //
      //   · lastSenderId는 자기 자신으로만 적을 수 있다. 남의 uid를 적으면
      //     상대 화면에서 "내가 마지막으로 말했다"가 되어 **상대의 안 읽음
      //     표시를 내가 꺼 버릴 수 있다.**
      //   · lastReadAt은 자기 칸만 건드릴 수 있다. 남의 칸을 미래로 밀면
      //     같은 일이 벌어지고, 과거로 되돌리면 없던 배지를 만들어 낼 수 있다.
      //
      // lastReadAt을 건드리지 않는 갱신에서는 양쪽 맵이 같아 affectedKeys()가
      // 비고, 빈 집합은 hasOnly를 통과하므로 미리보기 갱신은 영향받지 않는다.
      //
      // ⚠️ 배포 순서: **이 규칙이 앱보다 먼저 나가야 한다.** 새 앱은
      // sendMessage 배치에서 lastSenderId를 함께 적는데, 규칙이 그 키를 모르면
      // 업데이트가 거부되고 배치가 통째로 실패해 **메시지 전송 자체가 막힌다.**
      allow update: if isSignedIn() &&
        uid() in resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'lastReadAt',
                    'deletedAt']) &&
        (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['lastSenderId']) ||
          request.resource.data.lastSenderId == uid()) &&
        request.resource.data.get('lastReadAt', {})
          .diff(resource.data.get('lastReadAt', {}))
          .affectedKeys().hasOnly([uid()]) &&
        // ── 채팅방 삭제(deletedAt: {uid: ts}) ─────────────────────────────
        // 방을 지운 사람의 **목록에서만** 사라지게 하는 표시다. 문서도 메시지도
        // 지우지 않는다 — 관리자 채팅 관리(adminChatViewer.js)에 기록이 그대로
        // 남아야 하고, 상대의 대화는 아무 영향도 받지 않아야 하기 때문이다.
        // 목록은 deletedAt[uid]보다 새 메시지가 있으면 방을 다시 보여준다
        // (ChatService.isRoomDeletedFor) — 흔한 메신저와 같은 동작이다.
        //
        // lastReadAt과 **완전히 같은 이유로** 자기 칸만 건드릴 수 있다. 남의
        // 칸을 적으면 상대의 대화 목록에서 방을 지워 버릴 수 있다.
        request.resource.data.get('deletedAt', {})
          .diff(resource.data.get('deletedAt', {}))
          .affectedKeys().hasOnly([uid()]);

      // 방 문서를 실제로 지우는 길은 열지 않는다. 앱의 '채팅방 삭제'는 위
      // deletedAt[uid] 표시만 남기는 soft delete다 — 상대의 대화가 함께
      // 사라지면 안 되고, 관리자 채팅 관리에도 기록이 남아야 한다.
      allow delete: if false;

      match /messages/{messageId} {
        function room() {
          return get(/databases/$(database)/documents/chatRooms/$(roomId)).data;
        }

        allow read: if isSignedIn() && uid() in room().participants;

        // 보내는 사람은 **언제나 나 자신**이다.
        //
        // 예전에는 여기가 "이 방의 참가자 중 하나"까지만 요구했다. 자동 안내
        // 문구를 게스트 기기가 호스트 이름으로 대신 써야 했기 때문이다
        // (옛 ChatService.flushPendingAutoMessages). 그 느슨함 때문에 참가자 A가
        // 참가자 B의 uid로 아무 말이나 남길 수 있었다 — 대화 상대가 하지 않은
        // 약속·계좌·취소 통보를 위조할 수 있는 구멍이다.
        //
        // 자동 안내는 이제 서버(Admin SDK, functions/chatAutoMessages.js)에서만
        // 만들어진다. Admin SDK는 이 규칙을 우회하므로 여기서는 클라이언트만
        // 생각하면 되고, 그래서 senderId를 uid()로 그냥 못 박을 수 있다.
        //
        // isAuto도 함께 막는다 — 사람이 친 말이 호스트의 자동 안내인 척
        // (말풍선 위 '자동 안내' 배지) 보이게 만들 수 없다.
        allow create: if isActiveMember() &&
          uid() in room().participants &&
          request.resource.data.senderId == uid() &&
          request.resource.data.get('isAuto', false) == false &&
          request.resource.data.text is string &&
          request.resource.data.keys()
            .hasOnly(['senderId', 'senderName', 'text', 'isAuto', 'createdAt']);

        // ── 내가 보낸 말만 지울 수 있다(soft delete) ────────────────────
        //
        // 문서는 남기고 원문만 지운다. 규칙으로는 **필드 단위 읽기 제한이
        // 불가능**하므로, 원문을 문서에 남겨 두면 상대 기기에서든 관리자
        // 화면에서든 그대로 읽힌다 — 화면에서 가리는 것은 숨김이지 삭제가
        // 아니다. 그래서 text를 빈 문자열로 덮고, 있었다는 사실만
        // deletedAt/deletedBy로 남긴다(관리자 화면은 '(삭제된 메시지)'로만
        // 표시한다).
        //
        // 막는 것들:
        //  · resource.data.senderId == uid() — **남의 messageId를 넣어도**
        //    자기가 보낸 말이 아니면 여기서 끝난다. 앱 UI의 '내 말풍선만
        //    길게 누르기'는 편의일 뿐, 강제는 이 한 줄이다.
        //  · isAuto — 서버가 호스트 이름으로 내보낸 자동 안내는 사람이 쓴 말이
        //    아니다. 호스트가 자기 uid로 되어 있다고 지울 수 있으면 안 된다.
        //  · 이미 지운 말 다시 지우기 — deletedAt이 있으면 더는 못 건드린다
        //    (시각·삭제자 기록을 나중에 덮어쓰는 길을 막는다).
        //  · 그 밖의 필드 수정 — 바꿀 수 있는 키는 정확히 셋뿐이라 senderId나
        //    createdAt을 고쳐 말을 위조하는 경로가 없다. 보낸 말 '수정'은
        //    여전히 불가능하다(text는 빈 문자열로만 갈 수 있다).
        allow update: if isSignedIn() &&
          uid() in room().participants &&
          resource.data.senderId == uid() &&
          resource.data.get('isAuto', false) == false &&
          !('deletedAt' in resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'deletedAt', 'deletedBy']) &&
          request.resource.data.text == '' &&
          request.resource.data.deletedBy == uid() &&
          request.resource.data.deletedAt == request.time;

        // 문서를 실제로 지우는 길은 끝까지 열지 않는다 — 감사 기록이 사라진다.
        allow delete: if false;
      }
    }

    // ── refundRequests (환불 요청 큐) ───────────────────────────────────────
    // 참가자가 무통장입금 건을 취소해 **돌려줄 돈이 생겼을 때** 서버가 만드는
    // 문서. 자동 송금이 없어 운영자가 손으로 보내고, 보낸 뒤 상태를 넘긴다.
    //
    // 문서 안에는 **참가자의 환불계좌 사본**(은행·계좌번호·예금주)이 들어 있다.
    //
    // 읽기는 참가자 본인 · **그 건의 호스트** · 관리자다. 호스트가 들어온 이유는
    // 무통장입금을 파티츄가 아니라 **호스트가 직접 받기 때문**이다
    // (users/{uid}.payoutAccount — functions/payoutAccounts.js). 받은 사람이
    // 돌려주는 사람이므로, 호스트가 송금하려면 그 계좌를 봐야 한다. 대신
    // 볼 수 있는 범위는 자기 콘텐츠로 들어온 건 하나하나뿐이다.
    //
    // 쓰기는 전부 서버(Admin SDK)다: 접수는 cancelApplication이, 완료/반려는
    // completeRefundRequest가 한다. 클라이언트가 쓸 수 있으면 환불액이나
    // 처리 상태를 스스로 조작할 수 있다.
    match /refundRequests/{requestId} {
      allow get: if isSignedIn() && (
        resource.data.requesterId == uid() ||
        resource.data.get('hostId', '') == uid() ||
        isAdmin()
      );
      // 목록은 "내가 낸 것" / "내 콘텐츠로 들어온 것" / 관리자 전체.
      // 필터 없는 조회는 여기서 걸러진다.
      allow list: if isSignedIn() && (
        resource.data.requesterId == uid() ||
        resource.data.get('hostId', '') == uid() ||
        isAdmin()
      );

      allow create, update, delete: if false;
    }

    // ── pendingAutoMessages (자동 안내 발송 대기열) ─────────────────────────
    // 서버 내부 큐다. 호스트가 글에 적어둔 안내 문구를 "언제, 어느 방에, 누구
    // 이름으로" 내보낼지가 담긴다.
    //
    // 앱은 이 컬렉션을 직접 만지지 않는다 — scheduleChatAutoMessage /
    // flushChatAutoMessages onCall만 부르고, 실제 읽기·쓰기·발송은 Admin SDK가
    // 규칙을 우회해서 한다(functions/chatAutoMessages.js).
    //
    // 여기를 열면 senderId 강제가 무의미해진다: 큐에 남의 uid를 hostId로 적은
    // 문서를 하나 넣어두고 발송을 시키면, 서버가 그 사람 이름으로 메시지를
    // 만들어 주기 때문이다. 그래서 클라이언트 접근은 전부 막는다.
    match /pendingAutoMessages/{pendingId} {
      allow read, write: if false;
    }
  }
}
