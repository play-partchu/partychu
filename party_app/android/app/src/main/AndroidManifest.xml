<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- 프로필 사진 촬영(카메라로 원형 크롭) 기능에 필요 -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Android 13(API 33)부터 알림은 런타임 권한이다. 이 선언이 없으면
         권한 요청 자체가 즉시 거부되고 푸시가 조용히 사라진다. 12 이하에서는
         선언만 있고 요청은 일어나지 않는다(설치 시 자동 허용). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 카메라가 없는 기기(태블릿 등)도 스토어에서 제외되지 않도록 필수 아님으로 선언 -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- 앱이 백그라운드/종료 상태일 때 시스템이 알림을 그릴 채널.
             이 채널을 미리 만들어두지 않으면 Android 8+ 에서 알림이 기본
             채널로 떨어져 사용자가 종류별로 끌 수 없다. 채널 자체는
             PushNotificationService가 앱 시작 시 같은 id로 생성한다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="partychu_default" />

        <meta-data
            android:name="com.naver.maps.map.CLIENT_ID"
            android:value="tdehle93zg" />

        <meta-data
            android:name="com.naver.sdk.clientId"
            android:value="@string/naver_client_id" />
        <meta-data
            android:name="com.naver.sdk.clientSecret"
            android:value="@string/naver_client_secret" />
        <meta-data
            android:name="com.naver.sdk.clientName"
            android:value="@string/naver_client_name" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links — https://partychu.co.kr/party/{id} 클릭 시
                 브라우저를 거치지 않고 바로 이 앱으로 연결된다.
                 autoVerify="true"라 설치 시 OS가 website/.well-known/assetlinks.json을
                 확인해 이 앱이 실제 도메인 소유자가 맞는지 자동 검증한다
                 (검증 실패 시엔 일반 브라우저 선택 동작으로 안전하게 폴백). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="partychu.co.kr"
                    android:pathPrefix="/party" />
            </intent-filter>

            <!-- 커스텀 스킴 폴백 — 카카오톡 인앱 브라우저 등 일부 환경은 App Links를
                 존중하지 않을 수 있어 공유 페이지의 "PartyChu 앱에서 보기" 버튼이
                 이 스킴도 함께 시도한다(공식 App Links가 항상 우선 동작). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="partychu" android:host="party" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>

        <activity
            android:name="com.kakao.sdk.flutter.AuthCodeCustomTabsActivity"
            android:exported="true"
            android:launchMode="singleTask"
            tools:node="merge">
            <intent-filter android:label="flutter_web_auth">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kakao91dfa5c605e96ab544cfd919c2f439bb" android:host="oauth" />
            </intent-filter>
        </activity>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <package android:name="com.kakao.talk" />
        <package android:name="com.instagram.android" />
    </queries>
</manifest>